import { ListView } from "std-widgets.slint";

export struct MeterRow {
    id: int,
    name: string,
    class-name: string,
    class-icon: image,
    // combat power and gear score: "113k · 2,410" (party members only)
    gear: string,
    damage: string,
    dps: string,
    share: float,
    share-text: string,
    heal: string,
    taken: string,
    crit: string,
    local: bool,
    estimated: bool,
    color: color,
}

// One player in an overlay: damage or healing of the fight or the total.
export struct OverlayRow {
    id: int,
    name: string,
    class-icon: image,
    gear: string,
    value: string,
    rate: string,
    share: float,
    share-text: string,
    local: bool,
    color: color,
}

// The settings of one meter overlay. metric: 0 damage, 1 healing. range: 0 current fight, 1 total. scope: 0 all, 1 group, 2 me.
export struct OverlayConfigRow {
    id: int,
    enabled: bool,
    metric: int,
    range: int,
    scope: int,
}

export struct SkillRow {
    icon: image,
    name: string,
    total: string,
    hits: string,
    crit: string,
    share: float,
    // min - max, rate, hit kinds and ticks: "1.2k - 8.4k  ·  950/s  ·  back 32%"
    detail: string,
}

// One player's line on the DPS chart: path commands in the chart's pixels, and the value at the cursor (or the average).
export struct ChartLine {
    id: int,
    commands: string,
    color: color,
    name: string,
    value: string,
    local: bool,
}

// A death on the chart, at `x` (0..1 of the width).
export struct ChartMark {
    x: float,
    label: string,
}

// One stretch an effect was on, from `x` for `w` (0..1 of the timeline).
export struct BuffBar {
    x: float,
    w: float,
}

// An effect on the timeline: its icon, name, uptime, how often it went on, and when it was on.
export struct BuffLane {
    icon: image,
    name: string,
    uptime: string,
    count: string,
    own: bool,
    bars: [BuffBar],
}

// A field boss of the shown map: its state ("Up", "Back in 1:23:45"), a detail, and where it is.
export struct BossRow {
    name: string,
    status: string,
    detail: string,
    color: color,
    index: int,
    // ticked: its marker and return time show on the map
    shown: bool,
}

// A shown field boss whose marker is not on the map, pinned as a card in its corner.
export struct BossPin {
    icon: image,
    // the monster glyph when there is no icon
    glyph: bool,
    name: string,
    status: string,
    // the boss's map
    detail: string,
    color: color,
    world-id: int,
}

// One timed event on the Timers page: on now (until its end) or waiting for its next start.
export struct TimerRow {
    name: string,
    // "RESET", "EVENT"
    kind: string,
    // how its times read ("Every 3 h from 02:00")
    detail: string,
    // the time left ("1:02:03") and what it is until ("until it starts")
    countdown: string,
    caption: string,
    // the next start or, while on, the end ("next 21:00"), and the last start ("last 18:00"), in the region's clock
    when: string,
    last: string,
    color: color,
    on: bool,
    // 0..1: the share of the wait since the last one gone, or of the event while on
    progress: float,
}

export struct MapTile {
    image: image,
    x: length,
    y: length,
    size: length,
}

// The name of a spawn area, centred on (x, y): the middle under the area's bottom edge.
export struct MapLabel {
    x: length,
    y: length,
    text: string,
    color: color,
}

// One line of the resource or monster list. A header is a resource group that can be expanded.
export struct FilterRow {
    key: string,
    label: string,
    detail: string,
    header: bool,
    expanded: bool,
    checked: bool,
    // some but not all items of a group are selected
    partial: bool,
    color: color,
    // game icon of the resource kind or the pet (empty: the coloured dot)
    icon: image,
    // a monster without a portrait: the monster glyph instead of the dot
    glyph: bool,
    // a monster under its pet: indented
    child: bool,
}

// One line of the profile: "Combat power", "113,456".
export struct ProfileItem {
    label: string,
    value: string,
    // drawn in the warm colour (Odyle energy)
    accent: bool,
}

export struct ProfileSection {
    title: string,
    items: [ProfileItem],
}

// One pet with its level and how far it is to the next: "12/25", "13 left" (or "Max").
export struct PetRow {
    id: int,
    name: string,
    // the pet window's group: Cognia, Fera, Natura, Varia, Specia
    species: string,
    icon: image,
    level: int,
    progress: string,
    left: string,
    // to max: "93 to max"; empty at max
    to-max: string,
    share: float,
    pinned: bool,
    // the pet of the monster the player is fighting
    target: bool,
    max: bool,
}

// The zodiak palette.
export global Theme {
    out property <color> background: #101114;
    out property <color> chrome: #0c0d10;
    out property <color> chrome-line: #22232a;
    out property <color> surface: #191a20;
    out property <color> surface-raised: #22232b;
    out property <color> surface-hover: #272830;
    out property <color> control-hover: #30313c;
    out property <color> border: #2b2c35;
    out property <color> control-border: #33343e;
    out property <color> input: #111217;
    out property <color> text: #eeeef2;
    out property <color> muted: #9698a8;
    out property <color> faint: #737585;
    out property <color> accent: #a8a0ff;
    out property <color> accent-hover: #bcb6ff;
    out property <color> accent-ink: #17132b;
    out property <color> accent-soft: #2a273c;
    out property <color> danger: #f17b87;
    out property <color> warn: #e5c68a;
    out property <color> green: #68cba4;
    out property <length> radius: 10px;
}

