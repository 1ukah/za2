import { ListView } from "std-widgets.slint";

export struct MeterRow {
    id: int,
    name: string,
    class-name: string,
    class-icon: image,
    // combat power and gear score: "113k · 2,410" (party members only)
    gear: string,
    damage: string,
    dps: string,
    share: float,
    share-text: string,
    heal: string,
    crit: string,
    local: bool,
    estimated: bool,
    color: color,
}

// One player in an overlay: damage or healing of the fight or the total.
export struct OverlayRow {
    id: int,
    name: string,
    class-icon: image,
    gear: string,
    value: string,
    rate: string,
    share: float,
    share-text: string,
    local: bool,
    color: color,
}

// The settings of one meter overlay. metric: 0 damage, 1 healing. range: 0 current fight, 1 total. scope: 0 all, 1 group, 2 me.
export struct OverlayConfigRow {
    id: int,
    enabled: bool,
    metric: int,
    range: int,
    scope: int,
}

export struct SkillRow {
    icon: image,
    name: string,
    total: string,
    hits: string,
    crit: string,
    share: float,
    min-max: string,
}

export struct MapTile {
    image: image,
    x: length,
    y: length,
    size: length,
}

export struct MapMarker {
    x: length,
    y: length,
    size: length,
    color: color,
    // game icon drawn instead of the dot (empty: a dot)
    icon: image,
    live: bool,
    // 1 above the player, -1 below, 0 level or unknown
    level: int,
}

// One line of the resource or monster list. A header is a resource group that can be expanded.
export struct FilterRow {
    key: string,
    label: string,
    detail: string,
    header: bool,
    expanded: bool,
    checked: bool,
    // some but not all items of a group are selected
    partial: bool,
    color: color,
    // game icon of the resource kind or the pet (empty: the coloured dot)
    icon: image,
    // a monster under its pet: indented
    child: bool,
}

// The zodiak palette.
export global Theme {
    out property <color> background: #101114;
    out property <color> chrome: #0c0d10;
    out property <color> chrome-line: #22232a;
    out property <color> surface: #191a20;
    out property <color> surface-raised: #22232b;
    out property <color> surface-hover: #272830;
    out property <color> control-hover: #30313c;
    out property <color> border: #2b2c35;
    out property <color> control-border: #33343e;
    out property <color> input: #111217;
    out property <color> text: #eeeef2;
    out property <color> muted: #9698a8;
    out property <color> faint: #737585;
    out property <color> accent: #a8a0ff;
    out property <color> accent-hover: #bcb6ff;
    out property <color> accent-ink: #17132b;
    out property <color> accent-soft: #2a273c;
    out property <color> danger: #f17b87;
    out property <color> warn: #e5c68a;
    out property <color> green: #68cba4;
    out property <length> radius: 10px;
}

