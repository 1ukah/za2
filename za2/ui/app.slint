// ---------------------------------------------------------------- building blocks

component Icon inherits Path {
    in property <color> tint: Theme.text;
    width: 18px;
    height: 18px;
    viewbox-width: 24;
    viewbox-height: 24;
    stroke: tint;
    stroke-width: 1.4px;
    stroke-line-cap: round;
    fill: transparent;
}

// Round trip to the game server, coloured by how good it is.
component PingBadge inherits HorizontalLayout {
    in property <string> text;
    in property <color> tint;
    in property <length> font-size: 12px;
    spacing: 4px;
    alignment: end;
    Icon {
        y: (parent.height - self.height) / 2;
        width: root.font-size + 1px;
        height: root.font-size + 1px;
        commands: Icons.wifi;
        tint: root.tint;
        stroke-width: 2px;
    }
    Text {
        text: root.text;
        color: root.tint;
        font-size: root.font-size;
        font-weight: 600;
        vertical-alignment: center;
    }
}

component Card inherits Rectangle {
    background: Theme.surface;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.border;
}

component Label inherits Text {
    color: Theme.text;
    vertical-alignment: center;
}

component Muted inherits Text {
    color: Theme.muted;
    font-size: 12px;
    vertical-alignment: center;
}

component SectionTitle inherits Text {
    color: Theme.faint;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.8px;
    vertical-alignment: center;
}

// Icon-only button: transparent until hovered, lavender when pressed (zodiak's icon-button).
component IconButton inherits Rectangle {
    in property <string> icon;
    in property <bool> active;
    in property <bool> boxed;
    in property <length> icon-size: 18px;
    callback clicked;
    width: 34px;
    height: 34px;
    border-radius: 7px;
    background: root.active ? Theme.accent-soft : touch.has-hover ? Theme.surface-hover : root.boxed ? Theme.surface-raised.with-alpha(0.94) : transparent;
    border-width: root.boxed ? 1px : 0px;
    border-color: Theme.control-border;
    Icon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: root.icon-size;
        height: root.icon-size;
        commands: root.icon;
        tint: root.active ? Theme.accent : touch.has-hover ? Theme.text : Theme.muted;
    }
    touch := TouchArea { clicked => { root.clicked(); } }
}

component TextButton inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> primary;
    callback clicked;
    height: 34px;
    border-radius: 8px;
    background: root.primary ? (touch.has-hover ? Theme.accent-hover : Theme.accent) : (touch.has-hover ? Theme.control-hover : Theme.surface-raised);
    border-width: root.primary ? 0px : 1px;
    border-color: Theme.control-border;
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 8px;
        alignment: center;
        if root.icon != "": Icon {
            y: (parent.height - self.height) / 2;
            width: 16px;
            height: 16px;
            commands: root.icon;
            tint: root.primary ? Theme.accent-ink : Theme.text;
        }
        Text {
            text: root.text;
            color: root.primary ? Theme.accent-ink : #c5c6d1;
            font-size: 12px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
    touch := TouchArea { clicked => { root.clicked(); } }
}

// Segmented control, for choices that need words (All / Group / Me) or icons.
component Segment inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> active;
    callback clicked;
    height: 28px;
    border-radius: 6px;
    background: root.active ? Theme.accent-soft : touch.has-hover ? Theme.surface-hover : transparent;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 6px;
        alignment: center;
        if root.icon != "": Icon {
            y: (parent.height - self.height) / 2;
            width: 16px;
            height: 16px;
            commands: root.icon;
            tint: root.active ? Theme.accent : Theme.muted;
        }
        if root.text != "": Text {
            text: root.text;
            color: root.active ? Theme.accent : Theme.muted;
            font-size: 12px;
            font-weight: root.active ? 600 : 400;
            vertical-alignment: center;
        }
    }
    touch := TouchArea { clicked => { root.clicked(); } }
}

component SegmentBar inherits Rectangle {
    background: Theme.input;
    border-radius: 9px;
    border-width: 1px;
    border-color: Theme.border;
    // 3px padding + a 28px Segment + 3px padding, so the segments sit centred
    height: 34px;
}

component CheckMark inherits Rectangle {
    in property <bool> checked;
    in property <bool> partial;
    width: 16px;
    height: 16px;
    border-radius: 4px;
    background: root.checked || root.partial ? Theme.accent : transparent;
    border-width: root.checked || root.partial ? 0px : 1.5px;
    border-color: Theme.faint;
    if root.checked: Icon {
        x: 2px;
        y: 2px;
        width: 12px;
        height: 12px;
        commands: Icons.check;
        tint: Theme.accent-ink;
        stroke-width: 2px;
    }
    if !root.checked && root.partial: Rectangle {
        x: 4px;
        y: 7px;
        width: 8px;
        height: 2px;
        background: Theme.accent-ink;
    }
}

// A whole-row checkbox: dot, label, detail on the right.
component CheckRow inherits Rectangle {
    in property <string> text;
    in property <string> detail;
    in property <bool> checked;
    in property <bool> partial;
    in property <color> dot: transparent;
    // shown instead of the dot when there is one; the dot colour becomes its ring
    in property <image> icon;
    // the monster glyph instead of the dot when there is no icon
    in property <bool> glyph;
    in property <length> indent: 0px;
    callback toggled(bool);
    height: 30px;
    border-radius: 6px;
    background: touch.has-hover ? Theme.surface-hover : transparent;
    touch := TouchArea { clicked => { root.toggled(!root.checked); } }
    HorizontalLayout {
        padding-left: 8px + root.indent;
        padding-right: 8px;
        spacing: 9px;
        CheckMark {
            y: (parent.height - self.height) / 2;
            checked: root.checked;
            partial: root.partial;
        }
        if root.icon.width > 0 || root.glyph: Rectangle {
            width: 22px;
            height: 22px;
            y: (parent.height - self.height) / 2;
            border-radius: 11px;
            border-width: root.dot != transparent ? 2px : 0px;
            border-color: root.dot;
            // clipped to the circle, so a square icon fits the ring
            if root.icon.width > 0: Rectangle {
                x: 2px;
                y: 2px;
                width: 18px;
                height: 18px;
                border-radius: 9px;
                clip: true;
                Image {
                    width: 18px;
                    height: 18px;
                    source: root.icon;
                    image-fit: contain;
                }
            }
            if root.icon.width == 0: Icon {
                x: 4px;
                y: 4px;
                width: 14px;
                height: 14px;
                commands: Icons.skull;
                tint: root.dot != transparent ? root.dot : Theme.muted;
                stroke-width: 1.6px;
            }
        }
        if root.icon.width == 0 && !root.glyph && root.dot != transparent: Rectangle {
            width: 8px;
            height: 8px;
            y: (parent.height - self.height) / 2;
            border-radius: 4px;
            background: root.dot;
        }
        Text {
            text: root.text;
            color: Theme.text;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        Text {
            text: root.detail;
            color: Theme.faint;
            font-size: 11px;
            vertical-alignment: center;
        }
    }
}

component SearchField inherits Rectangle {
    in property <string> placeholder;
    in-out property <string> text;
    callback edited(string);
    height: 36px;
    border-radius: 8px;
    background: Theme.input;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : Theme.border;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 6px;
        spacing: 8px;
        Icon {
            y: (parent.height - self.height) / 2;
            width: 16px;
            height: 16px;
            commands: Icons.search;
            tint: Theme.faint;
        }
        Rectangle {
            horizontal-stretch: 1;
            clip: true;
            if root.text == "": Text {
                x: 0;
                width: parent.width;
                height: parent.height;
                text: root.placeholder;
                color: Theme.faint;
                vertical-alignment: center;
                horizontal-alignment: left;
            }
            input := TextInput {
                x: 0;
                width: parent.width;
                height: parent.height;
                text <=> root.text;
                color: Theme.text;
                single-line: true;
                vertical-alignment: center;
                horizontal-alignment: left;
                edited => { root.edited(self.text); }
            }
        }
        if root.text != "": IconButton {
            y: (parent.height - self.height) / 2;
            width: 24px;
            height: 24px;
            icon-size: 14px;
            icon: Icons.x;
            clicked => {
                root.text = "";
                root.edited("");
            }
        }
    }
}

// A dropdown drawn by us, inside the window.
component Dropdown inherits Rectangle {
    in property <[string]> model;
    in property <string> icon;
    in-out property <int> current-index;
    in property <length> popup-height: min(root.model.length * 32px + 10px, 340px);
    callback selected(int);
    height: 34px;
    border-radius: 8px;
    background: touch.has-hover ? Theme.surface-hover : Theme.input;
    border-width: 1px;
    border-color: Theme.border;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 8px;
        spacing: 8px;
        if root.icon != "": Icon {
            y: (parent.height - self.height) / 2;
            width: 16px;
            height: 16px;
            commands: root.icon;
            tint: Theme.muted;
        }
        Text {
            text: root.current-index >= 0 && root.current-index < root.model.length ? root.model[root.current-index] : "";
            color: Theme.text;
            overflow: elide;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        Icon {
            y: (parent.height - self.height) / 2;
            width: 16px;
            height: 16px;
            commands: Icons.chevron-down;
            tint: Theme.muted;
        }
    }
    touch := TouchArea { clicked => { popup.show(); } }
    popup := PopupWindow {
        x: 0;
        y: root.height + 4px;
        width: root.width;
        height: root.popup-height;
        Rectangle {
            background: Theme.surface;
            border-radius: 10px;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 18px;
            drop-shadow-color: #00000090;
            ListView {
                x: 5px;
                y: 5px;
                width: parent.width - 10px;
                height: parent.height - 10px;
                for item[i] in root.model: Rectangle {
                    height: 32px;
                    border-radius: 6px;
                    background: item-touch.has-hover ? Theme.surface-hover : (i == root.current-index ? Theme.accent-soft : transparent);
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        Text {
                            text: item;
                            color: i == root.current-index ? Theme.accent : Theme.text;
                            overflow: elide;
                            vertical-alignment: center;
                        }
                    }
                    item-touch := TouchArea {
                        clicked => {
                            root.current-index = i;
                            root.selected(i);
                            popup.close();
                        }
                    }
                }
            }
        }
    }
}

// zodiak's switch: 34 x 20, a 14 px knob 3 px in, #444551 off and lavender on.
component Toggle inherits Rectangle {
    in property <string> text;
    in-out property <bool> checked;
    callback toggled(bool);
    height: 28px;
    horizontal-stretch: 0;
    HorizontalLayout {
        spacing: 10px;
        alignment: start;
        Rectangle {
            width: 34px;
            height: 20px;
            y: (parent.height - self.height) / 2;
            border-radius: 10px;
            background: root.checked ? Theme.accent : #444551;
            animate background { duration: 150ms; }
            Rectangle {
                x: root.checked ? 17px : 3px;
                y: 3px;
                width: 14px;
                height: 14px;
                border-radius: 7px;
                background: root.checked ? #241f37 : #dddce6;
                animate x { duration: 150ms; easing: ease-out; }
            }
        }
        if root.text != "": Text {
            text: root.text;
            color: Theme.text;
            vertical-alignment: center;
        }
    }
    TouchArea {
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}

// A keyboard shortcut, as zodiak shows one.
component Kbd inherits Rectangle {
    in property <string> text;
    height: 18px;
    width: key.preferred-width + 10px;
    border-radius: 4px;
    border-width: 1px;
    border-color: #363742;
    key := Text {
        x: 5px;
        text: root.text;
        color: #858797;
        font-size: 11px;
        vertical-alignment: center;
    }
}

// Label left, switch right (zodiak's "check" row).
component SwitchRow inherits Rectangle {
    in property <string> text;
    in property <string> shortcut;
    in-out property <bool> checked;
    callback toggled(bool);
    height: 32px;
    HorizontalLayout {
        spacing: 10px;
        Text {
            text: root.text;
            color: #d0cfdd;
            font-size: 13px;
            vertical-alignment: center;
        }
        if root.shortcut != "": Kbd {
            y: (parent.height - self.height) / 2;
            text: root.shortcut;
        }
        Rectangle { horizontal-stretch: 1; }
        Toggle {
            y: (parent.height - self.height) / 2;
            checked <=> root.checked;
            toggled(on) => { root.toggled(on); }
        }
    }
}

// A column title that sorts the list: a click sorts by it, a second click turns the order round.
component SortHeader inherits Rectangle {
    in property <string> text;
    in property <int> column;
    in-out property <int> sort;
    in-out property <bool> descending;
    in property <TextHorizontalAlignment> align: left;
    callback changed();
    property <bool> active: root.sort == root.column;
    HorizontalLayout {
        spacing: 3px;
        alignment: root.align == TextHorizontalAlignment.right ? end : root.align == TextHorizontalAlignment.center ? center : start;
        SectionTitle {
            text: root.text;
            color: root.active ? Theme.accent : touch.has-hover ? Theme.muted : Theme.faint;
        }
        if root.active: Icon {
            y: (parent.height - self.height) / 2;
            width: 12px;
            height: 12px;
            commands: root.descending ? Icons.chevron-down : "M6 15 l6-6 6 6";
            tint: Theme.accent;
            stroke-width: 2px;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            if (root.active) {
                root.descending = !root.descending;
            } else {
                root.sort = root.column;
                root.descending = false;
            }
            root.changed();
        }
    }
}

// A field's caption (zodiak's "field" label).
component FieldLabel inherits Text {
    color: #a9abba;
    font-size: 12px;
}

component SettingsTab inherits Rectangle {
    in property <string> icon;
    in property <string> text;
    in property <bool> active;
    callback clicked;
    height: 40px;
    border-radius: 7px;
    background: root.active ? #2c293d : touch.has-hover ? Theme.surface-hover : transparent;
    HorizontalLayout {
        padding-left: 10px;
        spacing: 10px;
        Icon {
            y: (parent.height - self.height) / 2;
            width: 17px;
            height: 17px;
            commands: root.icon;
            tint: root.active ? #eeebff : touch.has-hover ? #ededf5 : #a9abba;
        }
        Text {
            text: root.text;
            color: root.active ? #eeebff : touch.has-hover ? #ededf5 : #a9abba;
            font-size: 13px;
            vertical-alignment: center;
        }
    }
    touch := TouchArea { clicked => { root.clicked(); } }
}

component SliderBar inherits Rectangle {
    in property <float> minimum: 0;
    in property <float> maximum: 1;
    in-out property <float> value;
    callback changed(float);
    property <float> ratio: max(0, min(1, (root.value - root.minimum) / (root.maximum - root.minimum)));
    height: 24px;
    min-width: 100px;
    function set-from(x: length) {
        root.value = root.minimum + (root.maximum - root.minimum) * max(0, min(1, (x - 7px) / max(1px, root.width - 14px)));
        root.changed(root.value);
    }
    Rectangle {
        x: 7px;
        y: (parent.height - self.height) / 2;
        width: parent.width - 14px;
        height: 4px;
        border-radius: 2px;
        background: Theme.surface-hover;
    }
    Rectangle {
        x: 7px;
        y: (parent.height - self.height) / 2;
        width: (parent.width - 14px) * root.ratio;
        height: 4px;
        border-radius: 2px;
        background: Theme.accent;
    }
    Rectangle {
        x: (parent.width - 14px) * root.ratio;
        y: (parent.height - self.height) / 2;
        width: 14px;
        height: 14px;
        border-radius: 7px;
        background: #eeeeee;
        drop-shadow-blur: 2px;
        drop-shadow-color: #111111;
    }
    drag := TouchArea {
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.set-from(self.mouse-x);
            }
        }
        moved => {
            if (self.pressed) {
                root.set-from(self.mouse-x);
            }
        }
    }
}

component WindowButton inherits Rectangle {
    in property <string> icon;
    in property <bool> danger;
    callback clicked;
    width: 46px;
    height: 32px;
    background: touch.has-hover ? (root.danger ? #c42b3c : Theme.surface-hover) : transparent;
    Icon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 15px;
        height: 15px;
        commands: root.icon;
        tint: touch.has-hover ? #ffffff : Theme.muted;
        stroke-width: 1.2px;
    }
    touch := TouchArea { clicked => { root.clicked(); } }
}

// A rail entry: icon, lavender when it is the open page, a tooltip on hover.
component RailButton inherits Rectangle {
    in property <string> icon;
    in property <string> tooltip;
    in property <bool> active;
    callback clicked;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: root.active ? Theme.accent-soft : touch.has-hover ? Theme.surface-hover : transparent;
    if root.active: Rectangle {
        x: -8px;
        y: 12px;
        width: 3px;
        height: 20px;
        border-radius: 2px;
        background: Theme.accent;
    }
    Icon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 20px;
        height: 20px;
        commands: root.icon;
        tint: root.active ? Theme.accent : touch.has-hover ? Theme.text : Theme.muted;
    }
    touch := TouchArea { clicked => { root.clicked(); } }
    if touch.has-hover && root.tooltip != "": Rectangle {
        x: parent.width + 10px;
        y: (parent.height - self.height) / 2;
        width: tip.preferred-width + 16px;
        height: 26px;
        border-radius: 6px;
        background: Theme.surface-raised;
        border-width: 1px;
        border-color: Theme.control-border;
        tip := Text {
            x: 8px;
            text: root.tooltip;
            color: Theme.text;
            font-size: 12px;
            vertical-alignment: center;
        }
    }
}

// ---------------------------------------------------------------- map

// A name on the map, centred on (x, y) and hanging below it.
component MapLabelChip inherits Rectangle {
    in property <MapLabel> data;
    x: data.x - self.width / 2;
    y: data.y + 2px;
    width: label-text.preferred-width + 10px;
    height: 18px;
    border-radius: 9px;
    background: #0b0c0fb8;
    label-text := Text {
        x: 5px;
        text: root.data.text;
        color: root.data.color;
        font-size: 11px;
        font-weight: 700;
        vertical-alignment: center;
    }
}

component MapView inherits Rectangle {
    in property <[MapTile]> tiles;
    in property <image> layer;
    in property <[MapLabel]> labels;
    // the names and return times of the field bosses shown
    in property <[MapLabel]> boss-labels;
    in property <bool> me-visible;
    in property <length> me-x;
    in property <length> me-y;
    in property <float> me-heading;
    in property <color> me-color;
    in property <string> me-label;
    // radius of the Hidden Cube radar circle around the player; 0: hidden
    in property <length> radar-radius;
    in property <bool> interactive: true;
    in property <bool> wheel-zoom: interactive;
    out property <length> view-width: self.width;
    out property <length> view-height: self.height;
    callback pan-by(length, length);
    callback zoom-by(float, length, length);
    background: #0b0c0f;
    clip: true;

    for t in tiles: Image {
        x: t.x;
        y: t.y;
        width: t.size;
        height: t.size;
        source: t.image;
        image-fit: fill;
    }

    // the markers and spawn areas, drawn by za2 into one image (see map::LayerPainter)
    Image {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        source: root.layer;
        image-fit: fill;
    }

    for l in labels: MapLabelChip { data: l; }
    for l in boss-labels: MapLabelChip { data: l; }

    if me-visible && radar-radius > 0: Rectangle {
        x: me-x - radar-radius;
        y: me-y - radar-radius;
        width: radar-radius * 2;
        height: radar-radius * 2;
        border-radius: radar-radius;
        background: #ffd84d14;
        border-width: 2px;
        border-color: #ffd84dcc;
    }

    if me-visible: Rectangle {
        x: me-x - 14px;
        y: me-y - 14px;
        width: 28px;
        height: 28px;
        Path {
            width: 28px;
            height: 28px;
            viewbox-width: 28;
            viewbox-height: 28;
            commands: "M 14 2 L 23 24 L 14 18 L 5 24 Z";
            fill: me-color;
            stroke: #000000;
            stroke-width: 1.5px;
            transform-rotation: me-heading * 1deg;
            transform-origin: { x: 14px, y: 14px };
        }
        if me-label != "": Text {
            y: 28px;
            x: -20px;
            width: 68px;
            horizontal-alignment: center;
            text: me-label;
            color: me-color;
            font-size: 11px;
            font-weight: 700;
        }
    }

    if interactive || wheel-zoom: TouchArea {
        property <length> last-x;
        property <length> last-y;
        mouse-cursor: !root.interactive ? MouseCursor.default : self.pressed ? MouseCursor.grabbing : MouseCursor.grab;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                self.last-x = self.mouse-x;
                self.last-y = self.mouse-y;
            }
        }
        moved => {
            if (self.pressed && root.interactive) {
                root.pan-by(self.mouse-x - self.last-x, self.mouse-y - self.last-y);
                self.last-x = self.mouse-x;
                self.last-y = self.mouse-y;
            }
        }
        scroll-event(e) => {
            root.zoom-by(e.delta-y / 1px, self.mouse-x, self.mouse-y);
            accept
        }
    }
}

// An icon in a row (class emblem, skill), centred vertically; keeps its place when there is no image.
component ClassIcon inherits Rectangle {
    in property <image> source;
    in property <length> size: 16px;
    width: size;
    Image {
        y: (root.height - root.size) / 2;
        width: root.size;
        height: root.size;
        source: root.source;
        image-fit: contain;
    }
}

// ---------------------------------------------------------------- meter rows

component RowBar inherits Rectangle {
    in property <MeterRow> data;
    in property <int> rank;
    in property <bool> compact;
    in property <bool> selected;
    callback clicked;
    height: compact ? 24px : 40px;
    border-radius: compact ? 5px : 8px;
    background: selected ? Theme.accent-soft : touch.has-hover && !compact ? Theme.surface-hover : (compact ? #ffffff08 : Theme.surface);
    clip: true;
    Rectangle {
        x: 0;
        width: parent.width * data.share;
        background: data.color.with-alpha(data.local ? 0.28 : 0.16);
    }
    Rectangle {
        x: 0;
        width: 3px;
        background: data.color;
    }
    touch := TouchArea { clicked => { root.clicked(); } }
    HorizontalLayout {
        padding-left: compact ? 8px : 12px;
        padding-right: compact ? 8px : 12px;
        spacing: 10px;
        if !compact: Text {
            text: root.rank;
            color: Theme.faint;
            font-size: 12px;
            width: 16px;
            vertical-alignment: center;
        }
        ClassIcon {
            source: data.class-icon;
            size: compact ? 16px : 22px;
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            HorizontalLayout {
                spacing: 6px;
                Text {
                    text: data.name + (data.estimated ? " ~" : "");
                    color: data.local ? Theme.accent : Theme.text;
                    font-weight: data.local ? 700 : 500;
                    overflow: elide;
                    horizontal-stretch: 0;
                }
                if data.gear != "": Text {
                    text: data.gear;
                    color: Theme.faint;
                    font-size: 11px;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
            }
            if !compact && data.class-name != "": Text {
                text: data.class-name;
                color: Theme.faint;
                font-size: 11px;
            }
        }
        Text {
            text: data.damage;
            color: Theme.muted;
            vertical-alignment: center;
            horizontal-alignment: right;
            width: compact ? 52px : 80px;
        }
        Text {
            text: data.dps;
            color: Theme.text;
            font-weight: 700;
            font-size: compact ? 13px : 14px;
            vertical-alignment: center;
            horizontal-alignment: right;
            width: compact ? 52px : 80px;
        }
        Text {
            text: data.share-text;
            color: Theme.muted;
            vertical-alignment: center;
            horizontal-alignment: right;
            width: 40px;
        }
        if !compact: Text {
            text: data.crit;
            color: Theme.muted;
            vertical-alignment: center;
            horizontal-alignment: right;
            width: 44px;
        }
        if !compact: Text {
            text: data.heal;
            color: Theme.green;
            vertical-alignment: center;
            horizontal-alignment: right;
            width: 64px;
        }
        if !compact: Text {
            text: data.taken;
            color: Theme.danger;
            vertical-alignment: center;
            horizontal-alignment: right;
            width: 64px;
        }
    }
}

// ---------------------------------------------------------------- overlays

// One skill of the breakdown: icon, name, total, hits, crit, on a bar as wide as its share; the full size adds the detail line.
component SkillBar inherits Rectangle {
    in property <SkillRow> data;
    in property <bool> compact;
    height: compact ? 22px : 38px;
    border-radius: compact ? 5px : 6px;
    clip: true;
    background: compact ? #ffffff08 : Theme.surface-raised;
    Rectangle {
        x: 0;
        width: parent.width * root.data.share;
        background: Theme.accent.with-alpha(0.16);
    }
    HorizontalLayout {
        padding-left: compact ? 4px : 6px;
        padding-right: 8px;
        spacing: compact ? 6px : 8px;
        ClassIcon { source: root.data.icon; size: compact ? 18px : 22px; }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            Text { text: root.data.name; color: Theme.text; overflow: elide; }
            if !compact && root.data.detail != "": Text { text: root.data.detail; color: Theme.faint; font-size: 11px; overflow: elide; }
        }
        Text { text: root.data.total; color: Theme.text; font-weight: 600; width: compact ? 48px : 64px; horizontal-alignment: right; vertical-alignment: center; }
        Text { text: root.data.hits; color: Theme.muted; width: compact ? 28px : 36px; horizontal-alignment: right; vertical-alignment: center; }
        Text { text: root.data.crit; color: Theme.muted; width: compact ? 32px : 40px; horizontal-alignment: right; vertical-alignment: center; }
    }
}

// Edges and corners that resize a frameless window: 0 n, 1 s, 2 e, 3 w, 4 ne, 5 nw, 6 se, 7 sw.
component ResizeGrips inherits Rectangle {
    in property <length> e: 5px;
    in property <length> c: 12px;
    callback resize(int);
    TouchArea { x: c; y: 0; width: parent.width - 2 * c; height: e; mouse-cursor: n-resize; pointer-event(ev) => { if (ev.kind == PointerEventKind.down) { root.resize(0); } } }
    TouchArea { x: c; y: parent.height - e; width: parent.width - 2 * c; height: e; mouse-cursor: s-resize; pointer-event(ev) => { if (ev.kind == PointerEventKind.down) { root.resize(1); } } }
    TouchArea { x: parent.width - e; y: c; width: e; height: parent.height - 2 * c; mouse-cursor: e-resize; pointer-event(ev) => { if (ev.kind == PointerEventKind.down) { root.resize(2); } } }
    TouchArea { x: 0; y: c; width: e; height: parent.height - 2 * c; mouse-cursor: w-resize; pointer-event(ev) => { if (ev.kind == PointerEventKind.down) { root.resize(3); } } }
    TouchArea { x: parent.width - c; y: 0; width: c; height: e; mouse-cursor: ne-resize; pointer-event(ev) => { if (ev.kind == PointerEventKind.down) { root.resize(4); } } }
    TouchArea { x: 0; y: 0; width: c; height: e; mouse-cursor: nw-resize; pointer-event(ev) => { if (ev.kind == PointerEventKind.down) { root.resize(5); } } }
    TouchArea { x: parent.width - c; y: parent.height - c; width: c; height: c; mouse-cursor: se-resize; pointer-event(ev) => { if (ev.kind == PointerEventKind.down) { root.resize(6); } } }
    TouchArea { x: 0; y: parent.height - c; width: c; height: c; mouse-cursor: sw-resize; pointer-event(ev) => { if (ev.kind == PointerEventKind.down) { root.resize(7); } } }
}

// A player in a meter overlay. A click shows the skills of the player; Ctrl+drag moves the overlay.
component OverlayRowBar inherits Rectangle {
    in property <OverlayRow> data;
    in property <bool> selected;
    in property <bool> clickable;
    callback clicked;
    callback drag();
    height: 24px;
    border-radius: 5px;
    background: root.selected ? Theme.accent-soft : touch.has-hover ? #ffffff14 : #ffffff08;
    clip: true;
    Rectangle {
        x: 0;
        width: parent.width * root.data.share;
        background: root.data.color.with-alpha(root.data.local ? 0.30 : 0.18);
    }
    Rectangle {
        x: 0;
        width: 3px;
        background: root.data.color;
    }
    touch := TouchArea {
        enabled: root.clickable;
        property <bool> moving;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                self.moving = e.modifiers.control;
                if (self.moving) { root.drag(); }
            }
        }
        clicked => {
            if (!self.moving) { root.clicked(); }
        }
    }
    HorizontalLayout {
        padding-left: 6px;
        padding-right: 8px;
        spacing: 6px;
        ClassIcon { source: root.data.class-icon; size: 16px; }
        HorizontalLayout {
            horizontal-stretch: 1;
            spacing: 6px;
            Text {
                text: root.data.name;
                color: root.data.local ? Theme.accent : Theme.text;
                font-weight: root.data.local ? 700 : 500;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 0;
            }
            if root.data.gear != "": Text { text: root.data.gear; color: Theme.faint; font-size: 11px; vertical-alignment: center; }
            Rectangle { horizontal-stretch: 1; }
        }
        Text { text: root.data.value; color: Theme.muted; vertical-alignment: center; horizontal-alignment: right; width: 48px; }
        Text { text: root.data.rate; color: Theme.text; font-weight: 700; vertical-alignment: center; horizontal-alignment: right; width: 48px; }
        Text { text: root.data.share-text; color: Theme.muted; vertical-alignment: center; horizontal-alignment: right; width: 34px; }
    }
}

// ---------------------------------------------------------------- pets

// A pet's picture in a ring: lavender for the fought monster's pet, green at max.
component PetIcon inherits Rectangle {
    in property <image> source;
    in property <color> ring: transparent;
    in property <length> size: 22px;
    width: root.size;
    height: root.size;
    border-radius: root.size / 2;
    border-width: root.ring != transparent ? 2px : 0px;
    border-color: root.ring;
    background: Theme.surface-raised;
    Rectangle {
        x: 2px;
        y: 2px;
        width: root.size - 4px;
        height: root.size - 4px;
        border-radius: (root.size - 4px) / 2;
        clip: true;
        if root.source.width > 0: Image {
            width: parent.width;
            height: parent.height;
            source: root.source;
            image-fit: contain;
        }
        if root.source.width == 0: Icon {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: parent.width * 0.7;
            height: parent.height * 0.7;
            commands: Icons.paw-print;
            tint: Theme.muted;
        }
    }
}

// Progress to the next level, with "12/25" on it.
component PetProgressBar inherits Rectangle {
    in property <float> share;
    in property <string> text;
    in property <bool> max;
    in property <length> font-size: 11px;
    border-radius: 4px;
    background: #ffffff10;
    clip: true;
    Rectangle {
        x: 0;
        width: parent.width * (root.max ? 1 : root.share);
        background: root.max ? Theme.green.with-alpha(0.35) : Theme.accent.with-alpha(0.45);
    }
    Text {
        text: root.text;
        color: Theme.text;
        font-size: root.font-size;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// A pet in the Pets tab: a click pins it to the overlay or unpins it.
component PetListRow inherits Rectangle {
    in property <PetRow> data;
    callback toggled(bool);
    height: 40px;
    border-radius: 7px;
    background: touch.has-hover ? Theme.surface-hover : root.data.pinned ? #ffffff08 : transparent;
    touch := TouchArea { clicked => { root.toggled(!root.data.pinned); } }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;
        PetIcon {
            y: (parent.height - self.height) / 2;
            size: 28px;
            source: root.data.icon;
            ring: root.data.target ? Theme.accent : root.data.max ? Theme.green : transparent;
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text { text: root.data.name; color: Theme.text; overflow: elide; }
            Text { text: root.data.species; color: Theme.faint; font-size: 11px; overflow: elide; }
        }
        Text {
            width: 52px;
            text: root.data.level > 0 ? "Lv " + root.data.level : "Locked";
            color: root.data.max ? Theme.green : root.data.level > 0 ? Theme.text : Theme.faint;
            font-weight: 600;
            vertical-alignment: center;
        }
        PetProgressBar {
            width: 120px;
            height: 18px;
            y: (parent.height - self.height) / 2;
            share: root.data.share;
            text: root.data.progress;
            max: root.data.max;
        }
        VerticalLayout {
            width: 78px;
            alignment: center;
            Text { text: root.data.left; color: root.data.max ? Theme.green : Theme.text; horizontal-alignment: right; }
            if root.data.to-max != "": Text { text: root.data.to-max; color: Theme.faint; font-size: 11px; horizontal-alignment: right; }
        }
        Rectangle {
            width: 28px;
            Icon {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 17px;
                height: 17px;
                commands: Icons.pin;
                tint: root.data.pinned ? Theme.accent : touch.has-hover ? Theme.muted : #ffffff22;
                stroke-width: root.data.pinned ? 2px : 1.4px;
            }
        }
    }
}

// A pet in the pet overlay.
component PetOverlayRow inherits Rectangle {
    in property <PetRow> data;
    height: 26px;
    border-radius: 5px;
    background: root.data.target ? Theme.accent-soft : #ffffff08;
    HorizontalLayout {
        padding-left: 4px;
        padding-right: 8px;
        spacing: 7px;
        PetIcon {
            y: (parent.height - self.height) / 2;
            size: 20px;
            source: root.data.icon;
            ring: root.data.target ? Theme.accent : root.data.max ? Theme.green : transparent;
        }
        Text {
            text: root.data.name;
            color: root.data.target ? Theme.accent : Theme.text;
            font-weight: root.data.target ? 700 : 500;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        Text {
            width: 20px;
            text: root.data.level > 0 ? "L" + root.data.level : "-";
            color: root.data.max ? Theme.green : Theme.muted;
            font-weight: 600;
            vertical-alignment: center;
            horizontal-alignment: right;
        }
        PetProgressBar {
            width: 58px;
            height: 16px;
            y: (parent.height - self.height) / 2;
            share: root.data.share;
            text: root.data.progress;
            max: root.data.max;
            font-size: 10px;
        }
        Text {
            width: 52px;
            text: root.data.left;
            color: root.data.max ? Theme.green : Theme.text;
            font-weight: 700;
            vertical-alignment: center;
            horizontal-alignment: right;
        }
    }
}

export component PetOverlay inherits Window {
    in property <[PetRow]> rows;
    in property <string> header;
    // shown when there are no rows
    in property <string> empty-text;
    in property <bool> locked;
    in property <float> overlay-opacity: 0.85;
    callback drag();
    callback toggle-lock();
    callback resize(int);
    title: "za2 pet overlay";
    icon: @image-url("brand/icon-256.png");
    no-frame: true;
    always-on-top: true;
    background: transparent;
    preferred-width: 340px;
    preferred-height: 150px;
    min-width: 200px;
    min-height: 60px;
    default-font-size: 12px;

    Rectangle {
        background: Theme.background.with-alpha(root.overlay-opacity);
        border-radius: Theme.radius;
        clip: true;
        if !root.locked: TouchArea {
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                    root.drag();
                }
            }
        }
        VerticalLayout {
            padding: 8px;
            spacing: 4px;
            alignment: start;
            Text {
                height: 20px;
                text: root.header;
                color: Theme.muted;
                font-size: 11px;
                overflow: elide;
                vertical-alignment: center;
            }
            for row in root.rows: PetOverlayRow { data: row; }
            if root.rows.length == 0: Text {
                text: root.empty-text;
                color: Theme.faint;
                font-size: 11px;
                wrap: word-wrap;
            }
        }
        if !root.locked: IconButton {
            x: parent.width - self.width - 4px;
            y: 4px;
            width: 26px;
            height: 26px;
            icon-size: 15px;
            boxed: true;
            icon: Icons.lock-open;
            clicked => { root.toggle-lock(); }
        }
        if !root.locked: ResizeGrips { resize(edge) => { root.resize(edge); } }
    }
}

export component MeterOverlay inherits Window {
    in property <[OverlayRow]> rows;
    in property <string> header;
    in property <string> overlay-title: "za2 DPS overlay";
    in property <bool> locked;
    in property <float> overlay-opacity: 0.85;
    // the player whose skills show under the rows (-1: none)
    in property <int> selected-id: -1;
    in property <string> skills-title;
    in property <[SkillRow]> skills;
    // footer: time to kill of the own target at the left, ping at the right ("" hides each)
    in property <string> ttk-text;
    in property <string> ping-text;
    in property <color> ping-color: Theme.green;
    callback drag();
    callback toggle-lock();
    callback select(int);
    callback resize(int);
    title: root.overlay-title;
    icon: @image-url("brand/icon-256.png");
    no-frame: true;
    always-on-top: true;
    background: transparent;
    preferred-width: 380px;
    preferred-height: 220px;
    min-width: 240px;
    min-height: 80px;
    default-font-size: 12px;

    Rectangle {
        background: Theme.background.with-alpha(root.overlay-opacity);
        border-radius: Theme.radius;
        if !root.locked: TouchArea {
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                    root.drag();
                }
            }
        }
        VerticalLayout {
            padding: 8px;
            spacing: 4px;
            Text {
                height: 20px;
                text: root.header;
                color: Theme.muted;
                font-size: 11px;
                overflow: elide;
                vertical-alignment: center;
            }
            for row in root.rows: OverlayRowBar {
                data: row;
                clickable: !root.locked;
                selected: row.id == root.selected-id;
                clicked => { root.select(row.id == root.selected-id ? -1 : row.id); }
                drag => { root.drag(); }
            }
            if root.selected-id >= 0: Rectangle {
                height: 1px;
                background: Theme.border;
            }
            if root.selected-id >= 0: HorizontalLayout {
                height: 20px;
                spacing: 4px;
                Text {
                    text: root.skills-title;
                    color: Theme.muted;
                    font-size: 11px;
                    font-weight: 600;
                    overflow: elide;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                if !root.locked: IconButton {
                    width: 20px;
                    height: 20px;
                    icon-size: 13px;
                    icon: Icons.x;
                    clicked => { root.select(-1); }
                }
            }
            if root.selected-id >= 0: ListView {
                vertical-stretch: 1;
                for k in root.skills: VerticalLayout {
                    padding-bottom: 2px;
                    SkillBar { data: k; compact: true; }
                }
            }
            if root.selected-id < 0: Rectangle { }
            if root.ttk-text != "" || root.ping-text != "": HorizontalLayout {
                height: 16px;
                padding-left: 2px;
                padding-right: 2px;
                Text {
                    text: root.ttk-text;
                    color: Theme.text;
                    font-size: 11px;
                    font-weight: 600;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                if root.ping-text != "": PingBadge { text: root.ping-text; tint: root.ping-color; font-size: 11px; }
            }
        }
        if !root.locked: IconButton {
            x: parent.width - self.width - 4px;
            y: 4px;
            width: 26px;
            height: 26px;
            icon-size: 15px;
            boxed: true;
            icon: Icons.lock-open;
            clicked => { root.toggle-lock(); }
        }
        if !root.locked: ResizeGrips { resize(edge) => { root.resize(edge); } }
    }
}

export component MapOverlay inherits Window {
    in property <[MapTile]> tiles;
    in property <image> layer;
    in property <[MapLabel]> labels;
    in property <[MapLabel]> boss-labels;
    in property <bool> me-visible;
    in property <length> me-x;
    in property <length> me-y;
    in property <float> me-heading;
    in property <color> me-color;
    in property <string> me-label;
    // radius of the Hidden Cube radar circle around the player; 0: hidden
    in property <length> radar-radius;
    in property <bool> locked;
    in property <float> overlay-opacity: 0.85;
    out property <length> view-width: map.view-width;
    out property <length> view-height: map.view-height;
    // the view is moved away from the player (shows the recenter button)
    in property <bool> panned;
    callback drag();
    callback toggle-lock();
    callback zoom-by(float);
    callback pan-by(length, length);
    callback recenter();
    callback resize(int);
    // quick search: resources ("g:" + key) and monsters ("p:" + id) of the map, shown or hidden with a tick
    in-out property <bool> search-open;
    in-out property <string> search-query;
    in property <[FilterRow]> search-rows;
    callback search(string);
    callback toggle-item(string, bool);
    title: "za2 map overlay";
    icon: @image-url("brand/icon-256.png");
    no-frame: true;
    always-on-top: true;
    background: transparent;
    preferred-width: 300px;
    preferred-height: 300px;
    min-width: 150px;
    min-height: 150px;

    Rectangle {
        opacity: root.overlay-opacity;
        border-radius: 12px;
        clip: true;
        map := MapView {
            tiles: root.tiles;
            layer: root.layer;
            labels: root.labels;
            boss-labels: root.boss-labels;
            me-visible: root.me-visible;
            me-x: root.me-x;
            me-y: root.me-y;
            me-heading: root.me-heading;
            me-color: root.me-color;
            me-label: root.me-label;
            radar-radius: root.radar-radius;
            interactive: false;
            wheel-zoom: false;
        }
        // a drag pans the map, Ctrl+drag moves the window, a double click returns to the player
        if !root.locked: TouchArea {
            property <length> last-x;
            property <length> last-y;
            property <bool> panning;
            mouse-cursor: self.pressed && self.panning ? MouseCursor.grabbing : MouseCursor.grab;
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                    self.panning = !e.modifiers.control;
                    self.last-x = self.mouse-x;
                    self.last-y = self.mouse-y;
                    if (!self.panning) { root.drag(); }
                }
            }
            moved => {
                if (self.pressed && self.panning) {
                    root.pan-by(self.mouse-x - self.last-x, self.mouse-y - self.last-y);
                    self.last-x = self.mouse-x;
                    self.last-y = self.mouse-y;
                }
            }
            double-clicked => { root.recenter(); }
            scroll-event(e) => {
                root.zoom-by(e.delta-y / 1px);
                accept
            }
        }
    }
    if !root.locked: HorizontalLayout {
        x: parent.width - self.preferred-width - 6px;
        y: 6px;
        spacing: 4px;
        if root.panned: IconButton { width: 26px; height: 26px; icon-size: 15px; boxed: true; icon: Icons.locate-fixed; clicked => { root.recenter(); } }
        IconButton { width: 26px; height: 26px; icon-size: 15px; boxed: true; icon: Icons.minus; clicked => { root.zoom-by(-120); } }
        IconButton { width: 26px; height: 26px; icon-size: 15px; boxed: true; icon: Icons.plus; clicked => { root.zoom-by(120); } }
        IconButton { width: 26px; height: 26px; icon-size: 15px; boxed: true; icon: Icons.lock-open; clicked => { root.toggle-lock(); } }
    }
    // a click anywhere outside the search closes it
    if !root.locked && root.search-open: TouchArea {
        clicked => { root.search-open = false; }
    }
    if !root.locked && root.search-open: Rectangle {
        x: 6px;
        y: 38px;
        width: parent.width - 12px;
        height: parent.height - 38px - 40px;
        background: Theme.surface.with-alpha(0.97);
        border-radius: 10px;
        border-width: 1px;
        border-color: Theme.border;
        TouchArea { }
        VerticalLayout {
            padding: 6px;
            spacing: 6px;
            SearchField {
                placeholder: "Resources and monsters";
                text <=> root.search-query;
                edited(t) => { root.search(t); }
            }
            ListView {
                vertical-stretch: 1;
                for r in root.search-rows: CheckRow {
                    text: r.label;
                    detail: r.detail;
                    checked: r.checked;
                    dot: r.color;
                    icon: r.icon;
                    glyph: r.glyph;
                    toggled(on) => { root.toggle-item(r.key, on); }
                }
            }
        }
    }
    if !root.locked: IconButton {
        x: parent.width - self.width - 6px;
        y: parent.height - self.height - 6px;
        width: 26px;
        height: 26px;
        icon-size: 15px;
        boxed: true;
        active: root.search-open;
        icon: Icons.search;
        clicked => {
            root.search-open = !root.search-open;
            if (root.search-open) { root.search(root.search-query); }
        }
    }
    if !root.locked: ResizeGrips { resize(edge) => { root.resize(edge); } }
}

// ---------------------------------------------------------------- main window

export component App inherits Window {
    title: "za2 - zodiak for Aion 2";
    icon: @image-url("brand/icon-256.png");
    no-frame: true;
    background: transparent;
    preferred-width: 1080px;
    preferred-height: 720px;
    min-width: 680px;
    min-height: 480px;
    default-font-size: 13px;

    in-out property <int> tab: 1;
    // the DPS page shows the meter (0) or the timeline (2); the rail button returns to the last one
    in-out property <int> dps-tab: 0;
    function open-dps() {
        root.tab = root.dps-tab;
        if (root.tab == 2) { root.chart-resized(); }
    }

    in property <string> capture-state;
    in property <color> capture-color: Theme.muted;
    in property <string> zone-name;
    in property <string> encounter-time;
    in property <string> encounter-total;
    in property <string> encounter-info;
    in property <string> ttk-text;
    in property <string> ping-text;
    in property <color> ping-color: Theme.green;
    in property <[MeterRow]> rows;
    in property <[SkillRow]> skills;
    in property <string> skills-title;
    // the skill card shows 0 damage dealt, 1 healing, 2 damage taken
    in-out property <int> skill-mode: 0;
    callback skill-mode-changed(int);

    // timeline tab: the DPS chart of the shown players, deaths, and the effects on the selected player or their target
    in property <[ChartLine]> chart-lines;
    in property <[ChartMark]> chart-marks;
    in property <string> chart-top;
    in property <string> chart-duration;
    in property <string> chart-cursor-time;
    in property <string> chart-empty;
    in-out property <length> chart-width;
    in-out property <length> chart-height;
    // where the mouse is over the chart (0..1), below 0 when it is not
    in-out property <float> chart-cursor: -1;
    callback chart-resized();
    callback chart-hover(float);
    // a click on the chart at (x, y), 0..1 of its size: selects the player whose line is there
    callback chart-click(float, float);
    in-out property <int> buff-mode: 0;
    callback buff-mode-changed(int);
    in property <string> buff-title;
    in property <string> buff-empty;
    in property <[BuffLane]> buff-lanes;

    // field bosses of the shown map
    in property <[BossRow]> boss-rows;
    in property <string> boss-summary;
    in-out property <string> boss-query;
    callback boss-search(string);
    callback focus-boss(int);
    callback toggle-boss(int, bool);
    in property <[MapLabel]> boss-labels;
    // the shown bosses out of view, pinned in the bottom left corner of the map, if pinning is on
    in property <[BossPin]> boss-pins;
    in-out property <bool> boss-pins-on: true;
    callback boss-pins-changed(bool);
    callback focus-pinned-boss(int);

    // the Timers page: the region's timetable, by the wall clock
    in property <[TimerRow]> timer-rows;
    in property <string> timer-clock;
    // width of the list beside the map; the user drags its left edge
    in-out property <length> sidebar-width: 300px;
    callback sidebar-width-changed(length);

    // profile tab: what is known of the own character, label and value per line, in sections
    in property <[ProfileSection]> profile;
    in property <string> profile-empty;
    in-out property <int> selected-row: -1;
    in-out property <int> scope: 0;
    in property <[string]> session-names: ["Current"];
    in-out property <int> session-index: 0;
    callback session-selected(int);
    callback reset();
    callback select-row(int);
    callback scope-changed(int);
    // the table shows the current fight (0) or the total (1)
    in-out property <int> meter-range: 0;
    callback meter-range-changed(int);
    in property <[OverlayConfigRow]> overlay-configs;
    callback overlay-add();
    callback overlay-remove(int);
    callback overlay-changed(OverlayConfigRow);

    in property <[MapTile]> tiles;
    in property <image> layer;
    in property <[MapLabel]> labels;
    in property <bool> me-visible;
    in property <length> me-x;
    in property <length> me-y;
    in property <float> me-heading;
    in property <color> me-color;
    in property <string> me-label;
    // radius of the Hidden Cube radar circle around the player; 0: hidden
    in property <length> radar-radius;
    in property <string> position-text;
    in property <color> position-color;
    in property <[string]> map-names;
    in-out property <int> map-index;
    in-out property <bool> follow: true;
    in-out property <length> map-width;
    in-out property <length> map-height;
    callback pan-by(length, length);
    callback zoom-by(float, length, length);
    callback map-selected(int);
    callback follow-changed(bool);
    callback center-on-player();

    in property <[FilterRow]> resource-rows;
    in property <[FilterRow]> monster-rows;
    in property <string> resource-summary;
    in property <string> monster-summary;
    in-out property <int> filter-tab: 0;
    in-out property <string> resource-query;
    in-out property <string> monster-query;
    in-out property <bool> show-live-mobs;
    in-out property <bool> show-cubes;
    // game icons of the live layers (empty: the coloured dots)
    in property <image> cube-icon;
    in-out property <bool> cube-sound;
    in-out property <float> cube-volume: 70;
    callback cube-sound-changed(bool);
    callback cube-volume-changed(float);
    // true starts a repeating test of the cube sound, false stops it
    callback test-cube-sound(bool);
    in-out property <bool> sound-panel-open;
    in-out property <bool> sound-testing;
    property <Point> sound-anchor;
    function close-sound-panel() {
        root.sound-panel-open = false;
        if (root.sound-testing) {
            root.sound-testing = false;
            root.test-cube-sound(false);
        }
    }
    callback live-mobs-changed(bool);
    callback cubes-changed(bool);
    callback toggle-gather(string, bool);
    callback toggle-kind(string, bool);
    callback expand-kind(string);
    callback toggle-pet(string, bool);
    callback toggle-monster(string, bool);
    callback expand-pet(string);
    callback resource-search(string);
    callback monster-search(string);
    callback select-shown-monsters();
    callback clear-monsters();
    callback clear-resources();

    // pets tab: every pet with its level and progress; pinned ones show in the pet overlay
    in property <[PetRow]> pet-rows;
    in property <string> pet-summary;
    in property <string> pet-source;
    in property <color> pet-source-color: Theme.muted;
    in-out property <string> pet-query;
    // 0 all, 1 pinned, 2 not at max yet
    in-out property <int> pet-filter: 0;
    // the pet type shown: 0 all types, then the types in `pet-species-names`
    in property <[string]> pet-species-names: ["All types"];
    in-out property <int> pet-species: 0;
    in-out property <bool> pet-overlay;
    in-out property <bool> pet-overlay-target: true;
    // the pinned pets follow the pets and monsters ticked on the map, and the other way round
    in-out property <bool> pet-auto-pin: true;
    callback pet-auto-pin-changed(bool);
    callback pet-search(string);
    callback pet-filter-changed(int);
    // the column the pets are sorted by: 0 name, 1 level, 2 progress, 3 kills left
    in-out property <int> pet-sort: 0;
    in-out property <bool> pet-sort-desc;
    callback pet-sort-changed();
    callback toggle-pin(int, bool);
    callback clear-pins();
    callback pet-overlay-changed(bool);
    callback pet-overlay-target-changed(bool);

    in-out property <bool> settings-open;
    in-out property <int> settings-tab: 0;
    // the sub tab of Overlays: 0 general, 1 meter, 2 map, 3 pets
    in-out property <int> overlay-settings-tab: 0;
    in-out property <string> own-name;
    in-out property <bool> reset-on-zone;
    in-out property <bool> meter-overlay;
    in-out property <bool> map-overlay;
    in-out property <bool> overlays-locked;
    in-out property <float> overlay-opacity: 0.85;
    in-out property <float> overlay-radius: 150;
    callback own-name-edited(string);
    callback reset-on-zone-changed(bool);
    callback meter-overlay-changed(bool);
    callback map-overlay-changed(bool);
    callback lock-changed(bool);
    callback opacity-changed(float);
    callback overlay-radius-changed(float);
    // zooms the map overlay; used by  --send map-zoom-in / map-zoom-out
    callback map-overlay-zoom(float);
    callback start-recording();
    callback stop-recording();
    in property <bool> recording;
    in property <string> recording-text;

    // the window has no system frame: the title bar moves it, its buttons control it, the edges resize it
    in property <bool> is-maximized;
    callback window-drag();
    callback window-minimize();
    callback window-maximize();
    callback window-close();
    // 0 north, 1 south, 2 east, 3 west, 4 north-east, 5 north-west, 6 south-east, 7 south-west
    callback window-resize(int);

    forward-focus: keys;

    Rectangle {
        background: Theme.background;
        border-radius: root.is-maximized ? 0px : 10px;
        border-width: root.is-maximized ? 0px : 1px;
        border-color: Theme.border;
        clip: true;

        keys := FocusScope {
            key-pressed(e) => {
                if (e.modifiers.control && e.text == "r") { root.reset(); return accept; }
                if (e.modifiers.control && e.text == "o") { root.meter-overlay = !root.meter-overlay; root.meter-overlay-changed(root.meter-overlay); return accept; }
                if (e.modifiers.control && e.text == "m") { root.map-overlay = !root.map-overlay; root.map-overlay-changed(root.map-overlay); return accept; }
                if (e.modifiers.control && e.text == "l") { root.overlays-locked = !root.overlays-locked; root.lock-changed(root.overlays-locked); return accept; }
                if (e.modifiers.control && e.text == "p") { root.pet-overlay = !root.pet-overlay; root.pet-overlay-changed(root.pet-overlay); return accept; }
                if (e.text == "1") { root.tab = 1; return accept; }
                if (e.text == "2") { root.open-dps(); return accept; }
                if (e.text == "3") { root.tab = 3; return accept; }
                if (e.text == "4") { root.tab = 4; return accept; }
                if (e.text == Key.Escape && root.settings-open) { root.settings-open = false; return accept; }
                reject
            }

            VerticalLayout {
                // ------------------------------------------------ title bar: logo in the middle, window buttons right
                Rectangle {
                    height: 32px;
                    background: Theme.chrome;
                    // moving starts only once the pressed mouse moves, so a double click stays with us and maximizes
                    TouchArea {
                        property <length> press-x;
                        property <length> press-y;
                        pointer-event(e) => {
                            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                                self.press-x = self.mouse-x;
                                self.press-y = self.mouse-y;
                            }
                        }
                        moved => {
                            if (self.pressed && (abs(self.mouse-x - self.press-x) > 4px || abs(self.mouse-y - self.press-y) > 4px)) {
                                root.window-drag();
                            }
                        }
                        double-clicked => { root.window-maximize(); }
                    }
                    Path {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        width: 22px;
                        height: 9.4px;
                        viewbox-width: 1129.75;
                        viewbox-height: 481.65;
                        fill: #f7f5f1;
                        commands: "M1129.75,240.83c-81.04-81.04-175.16-141.02-275.54-179.94,18.1,29.02,31.94,60.96,40.66,94.96,7.95,30.97-17.05,60.9-49.02,60.9h-.05c-22.16,0-42.15-14.5-47.66-35.96C771.47,76.83,677.15,0,564.87,0s-206.59,76.83-233.27,180.78c-5.51,21.46-25.5,35.96-47.66,35.96h-.05c-31.97,0-56.97-29.93-49.02-60.9,8.72-34,22.56-65.94,40.66-94.96C175.14,99.81,81.04,159.79,0,240.83c81.04,81.04,175.14,141.02,275.54,179.94-18.89-30.29-33.13-63.78-41.75-99.46-7.47-30.91,17.39-60.51,49.18-60.51h0c22.43,0,42.59,14.86,47.85,36.67,25.47,105.67,120.57,184.18,234.05,184.18s208.58-78.52,234.05-184.18c5.26-21.81,25.42-36.67,47.85-36.67h0c31.8,0,56.65,29.6,49.18,60.51-8.62,35.68-22.86,69.17-41.75,99.46,100.38-38.92,194.5-98.9,275.54-179.94Z";
                    }
                    HorizontalLayout {
                        x: parent.width - self.preferred-width;
                        height: parent.height;
                        WindowButton { icon: Icons.minus; clicked => { root.window-minimize(); } }
                        WindowButton { icon: root.is-maximized ? Icons.copy : Icons.square; clicked => { root.window-maximize(); } }
                        WindowButton { icon: Icons.x; danger: true; clicked => { root.window-close(); } }
                    }
                    Rectangle {
                        y: parent.height - 1px;
                        height: 1px;
                        background: #292a33;
                    }
                }

                HorizontalLayout {
                    vertical-stretch: 1;
                    // ------------------------------------------------ pages
                    Rectangle {
                        horizontal-stretch: 1;
                        VerticalLayout {
                            x: 68px;
                            width: parent.width - 68px;
                            padding: 16px;
                            spacing: 12px;

                            // DPS: the meter and the timeline, as sub tabs
                            // the sub tabs in the middle; the fight or total and the encounter at the right hold for both
                            if root.tab == 0 || root.tab == 2: VerticalLayout {
                                spacing: 12px;
                                Rectangle {
                                    height: 34px;
                                    // centred on the page, whatever is at the right
                                    tabs := SegmentBar {
                                        x: (parent.width - self.width) / 2;
                                        width: self.preferred-width;
                                        HorizontalLayout {
                                            padding: 3px;
                                            spacing: 2px;
                                            Segment { text: "Meter"; icon: Icons.swords; active: root.tab == 0; clicked => { root.dps-tab = 0; root.tab = 0; } }
                                            Segment { text: "Timeline"; icon: Icons.chart-line; active: root.tab == 2; clicked => { root.dps-tab = 2; root.tab = 2; root.chart-resized(); } }
                                        }
                                    }
                                    HorizontalLayout {
                                        x: max(tabs.x + tabs.width + 10px, parent.width - self.preferred-width);
                                        width: self.preferred-width;
                                        spacing: 10px;
                                        SegmentBar {
                                            HorizontalLayout {
                                                padding: 3px;
                                                spacing: 2px;
                                                Segment { text: "Fight"; active: root.meter-range == 0; clicked => { root.meter-range = 0; root.meter-range-changed(0); } }
                                                Segment { text: "Total"; active: root.meter-range == 1; clicked => { root.meter-range = 1; root.meter-range-changed(1); } }
                                            }
                                        }
                                        Dropdown {
                                            icon: Icons.history;
                                            model: root.session-names;
                                            current-index <=> root.session-index;
                                            selected(i) => { root.session-selected(i); }
                                            width: 220px;
                                        }
                                    }
                                }
                                Rectangle { height: 1px; background: Theme.border; }
                            }

                            // meter
                            if root.tab == 0: HorizontalLayout {
                                spacing: 12px;
                                VerticalLayout {
                                    spacing: 10px;
                                    horizontal-stretch: 3;
                                    HorizontalLayout {
                                        height: 48px;
                                        spacing: 10px;
                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 2px;
                                            horizontal-stretch: 1;
                                            HorizontalLayout {
                                                spacing: 10px;
                                                alignment: start;
                                                Text { text: root.encounter-time; color: Theme.text; font-size: 22px; font-weight: 700; }
                                                Text { text: root.encounter-total; color: Theme.muted; vertical-alignment: bottom; }
                                                if root.ttk-text != "": Text { text: root.ttk-text; color: Theme.text; font-weight: 600; vertical-alignment: bottom; }
                                            }
                                            Text { text: root.encounter-info; color: Theme.faint; font-size: 12px; overflow: elide; }
                                        }
                                        SegmentBar {
                                            y: (parent.height - self.height) / 2;
                                            HorizontalLayout {
                                                padding: 3px;
                                                spacing: 2px;
                                                Segment { text: "All"; active: root.scope == 0; clicked => { root.scope = 0; root.scope-changed(0); } }
                                                Segment { text: "Group"; active: root.scope == 1; clicked => { root.scope = 1; root.scope-changed(1); } }
                                                Segment { text: "Me"; active: root.scope == 2; clicked => { root.scope = 2; root.scope-changed(2); } }
                                            }
                                        }
                                        IconButton { y: (parent.height - self.height) / 2; boxed: true; icon: Icons.rotate-ccw; clicked => { root.reset(); } }
                                        Toggle {
                                            y: (parent.height - self.height) / 2;
                                            text: "Overlay";
                                            checked <=> root.meter-overlay;
                                            toggled(on) => { root.meter-overlay-changed(on); }
                                        }
                                    }
                                    HorizontalLayout {
                                        padding-left: 12px;
                                        padding-right: 12px;
                                        spacing: 10px;
                                        height: 16px;
                                        SectionTitle { text: "#"; width: 16px; }
                                        SectionTitle { text: "PLAYER"; horizontal-stretch: 1; }
                                        SectionTitle { text: "DAMAGE"; width: 80px; horizontal-alignment: right; }
                                        SectionTitle { text: "DPS"; width: 80px; horizontal-alignment: right; }
                                        SectionTitle { text: "SHARE"; width: 40px; horizontal-alignment: right; }
                                        SectionTitle { text: "CRIT"; width: 44px; horizontal-alignment: right; }
                                        SectionTitle { text: "HEAL"; width: 64px; horizontal-alignment: right; }
                                        SectionTitle { text: "TAKEN"; width: 64px; horizontal-alignment: right; }
                                    }
                                    ListView {
                                        for row[i] in root.rows: VerticalLayout {
                                            padding-bottom: 4px;
                                            RowBar {
                                                data: row;
                                                rank: i + 1;
                                                selected: root.selected-row == row.id;
                                                clicked => { root.select-row(row.id); }
                                            }
                                        }
                                    }
                                }
                                Card {
                                    horizontal-stretch: 2;
                                    VerticalLayout {
                                        padding: 12px;
                                        spacing: 6px;
                                        HorizontalLayout {
                                            spacing: 8px;
                                            height: 30px;
                                            Label { text: root.skills-title; font-weight: 600; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; }
                                            SegmentBar {
                                                HorizontalLayout {
                                                    padding: 3px;
                                                    spacing: 2px;
                                                    Segment { text: "Dealt"; active: root.skill-mode == 0; clicked => { root.skill-mode = 0; root.skill-mode-changed(0); } }
                                                    Segment { text: "Healed"; active: root.skill-mode == 1; clicked => { root.skill-mode = 1; root.skill-mode-changed(1); } }
                                                    Segment { text: "Taken"; active: root.skill-mode == 2; clicked => { root.skill-mode = 2; root.skill-mode-changed(2); } }
                                                }
                                            }
                                        }
                                        HorizontalLayout {
                                            spacing: 8px;
                                            height: 16px;
                                            SectionTitle { text: "SKILL"; horizontal-stretch: 1; }
                                            SectionTitle { text: "TOTAL"; width: 64px; horizontal-alignment: right; }
                                            SectionTitle { text: "HITS"; width: 36px; horizontal-alignment: right; }
                                            SectionTitle { text: "CRIT"; width: 40px; horizontal-alignment: right; }
                                        }
                                        ListView {
                                            for s in root.skills: VerticalLayout {
                                                padding-bottom: 3px;
                                                SkillBar { data: s; }
                                            }
                                        }
                                    }
                                }
                            }

                            // timeline
                            if root.tab == 2: VerticalLayout {
                                spacing: 10px;
                                HorizontalLayout {
                                    height: 48px;
                                    spacing: 10px;
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 2px;
                                        horizontal-stretch: 1;
                                        HorizontalLayout {
                                            spacing: 10px;
                                            alignment: start;
                                            Text { text: root.encounter-time; color: Theme.text; font-size: 22px; font-weight: 700; }
                                            Text { text: root.encounter-total; color: Theme.muted; vertical-alignment: bottom; }
                                        }
                                        Text { text: root.encounter-info; color: Theme.faint; font-size: 12px; overflow: elide; }
                                    }
                                }
                                Card {
                                    vertical-stretch: 3;
                                    VerticalLayout {
                                        padding: 12px;
                                        spacing: 8px;
                                        HorizontalLayout {
                                            spacing: 12px;
                                            height: 20px;
                                            Label { text: "DPS over time"; font-weight: 600; vertical-alignment: center; }
                                            for line in root.chart-lines: HorizontalLayout {
                                                spacing: 5px;
                                                Rectangle { width: 10px; height: 3px; y: (parent.height - self.height) / 2; border-radius: 1.5px; background: line.color; }
                                                Text {
                                                    text: line.name + "  " + line.value;
                                                    color: line.local ? Theme.accent : (root.selected-row == line.id ? Theme.text : Theme.muted);
                                                    font-size: 11px;
                                                    font-weight: root.selected-row == line.id ? 700 : 400;
                                                    vertical-alignment: center;
                                                    TouchArea { clicked => { root.select-row(line.id); } }
                                                }
                                            }
                                            Rectangle { horizontal-stretch: 1; }
                                        }
                                        HorizontalLayout {
                                            spacing: 6px;
                                            vertical-stretch: 1;
                                            VerticalLayout {
                                                width: 44px;
                                                Muted { text: root.chart-top; font-size: 11px; horizontal-alignment: right; }
                                                Rectangle { vertical-stretch: 1; }
                                                Muted { text: "0"; font-size: 11px; horizontal-alignment: right; }
                                            }
                                            plot := Rectangle {
                                                horizontal-stretch: 1;
                                                clip: true;
                                                init => { root.chart-width = self.width; root.chart-height = self.height; root.chart-resized(); }
                                                changed width => { root.chart-width = self.width; root.chart-resized(); }
                                                changed height => { root.chart-height = self.height; root.chart-resized(); }
                                                for f in [0, 0.25, 0.5, 0.75, 1]: Rectangle {
                                                    y: parent.height * f - (f == 1 ? 1px : 0);
                                                    height: 1px;
                                                    background: Theme.border;
                                                }
                                                for line in root.chart-lines: Path {
                                                    x: 0;
                                                    y: 0;
                                                    width: parent.width;
                                                    height: parent.height;
                                                    viewbox-width: parent.width / 1px;
                                                    viewbox-height: parent.height / 1px;
                                                    commands: line.commands;
                                                    stroke: line.color;
                                                    stroke-width: line.local || root.selected-row == line.id ? 2.5px : 1.5px;
                                                }
                                                for m in root.chart-marks: Rectangle {
                                                    x: parent.width * m.x - 1px;
                                                    width: 2px;
                                                    background: Theme.danger.with-alpha(0.7);
                                                    Text {
                                                        x: 4px;
                                                        y: 2px;
                                                        text: m.label;
                                                        color: Theme.danger;
                                                        font-size: 10px;
                                                    }
                                                }
                                                if root.chart-cursor >= 0: Rectangle {
                                                    x: parent.width * root.chart-cursor;
                                                    width: 1px;
                                                    background: Theme.muted;
                                                }
                                                if root.chart-empty != "": Muted {
                                                    text: root.chart-empty;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                                hover := TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => { root.chart-click(self.mouse-x / self.width, self.mouse-y / self.height); }
                                                    moved => { root.chart-hover(self.mouse-x / self.width); }
                                                    changed has-hover => { if (!self.has-hover) { root.chart-hover(-1); } }
                                                }
                                            }
                                        }
                                        HorizontalLayout {
                                            padding-left: 50px;
                                            height: 14px;
                                            Muted { text: "0:00"; font-size: 11px; }
                                            Muted { text: root.chart-cursor-time; font-size: 11px; horizontal-stretch: 1; horizontal-alignment: center; }
                                            Muted { text: root.chart-duration; font-size: 11px; }
                                        }
                                    }
                                }
                                Card {
                                    vertical-stretch: 2;
                                    VerticalLayout {
                                        padding: 12px;
                                        spacing: 6px;
                                        HorizontalLayout {
                                            spacing: 8px;
                                            height: 30px;
                                            Label { text: root.buff-title; font-weight: 600; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; }
                                            SegmentBar {
                                                HorizontalLayout {
                                                    padding: 3px;
                                                    spacing: 2px;
                                                    Segment { text: "On player"; active: root.buff-mode == 0; clicked => { root.buff-mode = 0; root.buff-mode-changed(0); } }
                                                    Segment { text: "On target"; active: root.buff-mode == 1; clicked => { root.buff-mode = 1; root.buff-mode-changed(1); } }
                                                }
                                            }
                                        }
                                        HorizontalLayout {
                                            spacing: 8px;
                                            height: 16px;
                                            SectionTitle { text: "EFFECT"; width: 190px; }
                                            SectionTitle { text: "TIMELINE"; horizontal-stretch: 1; }
                                            SectionTitle { text: "UPTIME"; width: 48px; horizontal-alignment: right; }
                                            SectionTitle { text: "TIMES"; width: 40px; horizontal-alignment: right; }
                                        }
                                        if root.buff-lanes.length == 0: Muted {
                                            text: root.buff-empty;
                                            horizontal-alignment: center;
                                            height: 40px;
                                        }
                                        ListView {
                                            for lane in root.buff-lanes: HorizontalLayout {
                                                spacing: 8px;
                                                height: 26px;
                                                padding-bottom: 3px;
                                                HorizontalLayout {
                                                    width: 190px;
                                                    spacing: 6px;
                                                    ClassIcon { source: lane.icon; size: 20px; }
                                                    Text { text: lane.name; color: lane.own ? Theme.text : Theme.muted; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; }
                                                }
                                                Rectangle {
                                                    horizontal-stretch: 1;
                                                    border-radius: 4px;
                                                    background: Theme.surface-raised;
                                                    clip: true;
                                                    for b in lane.bars: Rectangle {
                                                        x: parent.width * b.x;
                                                        width: max(1px, parent.width * b.w);
                                                        background: (lane.own ? Theme.accent : Theme.green).with-alpha(0.55);
                                                    }
                                                    if root.chart-cursor >= 0: Rectangle {
                                                        x: parent.width * root.chart-cursor;
                                                        width: 1px;
                                                        background: Theme.muted;
                                                    }
                                                }
                                                Text { text: lane.uptime; color: Theme.text; width: 48px; horizontal-alignment: right; vertical-alignment: center; }
                                                Text { text: lane.count; color: Theme.muted; width: 40px; horizontal-alignment: right; vertical-alignment: center; }
                                            }
                                        }
                                    }
                                }
                            }

                            // map
                            // pets
                            if root.tab == 3: VerticalLayout {
                                spacing: 10px;
                                HorizontalLayout {
                                    height: 36px;
                                    spacing: 10px;
                                    SearchField {
                                        horizontal-stretch: 1;
                                        placeholder: "Search pets or species";
                                        text <=> root.pet-query;
                                        edited(t) => { root.pet-search(t); }
                                    }
                                    Dropdown {
                                        y: (parent.height - self.height) / 2;
                                        width: 150px;
                                        icon: Icons.paw-print;
                                        model: root.pet-species-names;
                                        current-index <=> root.pet-species;
                                        selected(i) => { root.pet-filter-changed(root.pet-filter); }
                                    }
                                    SegmentBar {
                                        y: (parent.height - self.height) / 2;
                                        HorizontalLayout {
                                            padding: 3px;
                                            spacing: 2px;
                                            Segment { text: "All"; active: root.pet-filter == 0; clicked => { root.pet-filter = 0; root.pet-filter-changed(0); } }
                                            Segment { text: "Pinned"; active: root.pet-filter == 1; clicked => { root.pet-filter = 1; root.pet-filter-changed(1); } }
                                            Segment { text: "Unfinished"; active: root.pet-filter == 2; clicked => { root.pet-filter = 2; root.pet-filter-changed(2); } }
                                        }
                                    }
                                    Toggle {
                                        y: (parent.height - self.height) / 2;
                                        text: "Overlay";
                                        checked <=> root.pet-overlay;
                                        toggled(on) => { root.pet-overlay-changed(on); }
                                    }
                                }
                                HorizontalLayout {
                                    height: 22px;
                                    spacing: 10px;
                                    padding-left: 4px;
                                    Rectangle {
                                        width: 8px;
                                        height: 8px;
                                        y: (parent.height - self.height) / 2;
                                        border-radius: 4px;
                                        background: root.pet-source-color;
                                    }
                                    Muted { text: root.pet-source; font-size: 11px; }
                                    Muted { text: root.pet-summary; font-size: 11px; color: Theme.faint; horizontal-stretch: 1; overflow: elide; }
                                    Text {
                                        text: "Unpin all";
                                        color: unpin.has-hover ? Theme.accent-hover : Theme.accent;
                                        font-size: 11px;
                                        vertical-alignment: center;
                                        unpin := TouchArea { clicked => { root.clear-pins(); } }
                                    }
                                }
                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    spacing: 10px;
                                    height: 16px;
                                    Rectangle { width: 28px; }
                                    SortHeader { text: "PET"; column: 0; sort <=> root.pet-sort; descending <=> root.pet-sort-desc; changed => { root.pet-sort-changed(); } horizontal-stretch: 1; }
                                    SortHeader { text: "LEVEL"; column: 1; sort <=> root.pet-sort; descending <=> root.pet-sort-desc; changed => { root.pet-sort-changed(); } width: 52px; }
                                    SortHeader { text: "PROGRESS"; column: 2; sort <=> root.pet-sort; descending <=> root.pet-sort-desc; changed => { root.pet-sort-changed(); } width: 120px; align: center; }
                                    SortHeader { text: "LEFT"; column: 3; sort <=> root.pet-sort; descending <=> root.pet-sort-desc; changed => { root.pet-sort-changed(); } width: 78px; align: right; }
                                    SectionTitle { text: "PIN"; width: 28px; horizontal-alignment: center; }
                                }
                                ListView {
                                    vertical-stretch: 1;
                                    for row in root.pet-rows: VerticalLayout {
                                        padding-bottom: 2px;
                                        PetListRow {
                                            data: row;
                                            toggled(on) => { root.toggle-pin(row.id, on); }
                                        }
                                    }
                                }
                                if root.pet-rows.length == 0: Muted {
                                    text: root.pet-filter == 1 ? "No pinned pets. Click a pet in All to pin it to the overlay." : "No pet matches.";
                                    horizontal-alignment: center;
                                    height: 40px;
                                }
                            }

                            if root.tab == 4: VerticalLayout {
                                spacing: 12px;
                                if root.profile.length == 0: Muted {
                                    text: root.profile-empty;
                                    horizontal-alignment: center;
                                    height: 40px;
                                }
                                Flickable {
                                    vertical-stretch: 1;
                                    content-height: profile-grid.preferred-height;
                                    profile-grid := VerticalLayout {
                                        spacing: 12px;
                                        alignment: start;
                                        for section in root.profile: Card {
                                            VerticalLayout {
                                                padding: 14px;
                                                spacing: 4px;
                                                SectionTitle { text: section.title; height: 20px; }
                                                for item in section.items: HorizontalLayout {
                                                    height: 26px;
                                                    spacing: 12px;
                                                    Text { text: item.label; color: Theme.muted; width: 180px; vertical-alignment: center; overflow: elide; }
                                                    Text { text: item.value; color: item.accent ? Theme.warn : Theme.text; font-weight: 600; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            if root.tab == 5: VerticalLayout {
                                spacing: 12px;
                                Card {
                                    VerticalLayout {
                                        padding: 14px;
                                        SectionTitle { text: "SERVER TIME"; }
                                        Text { text: root.timer-clock; color: Theme.text; font-size: 16px; font-weight: 600; }
                                    }
                                }
                                // the cards in as many columns as fit
                                timer-board := Flickable {
                                    vertical-stretch: 1;
                                    property <length> gap: 12px;
                                    property <int> columns: max(1, floor((self.width + self.gap) / (260px + self.gap)));
                                    property <length> card-width: (self.width - (self.columns - 1) * self.gap) / self.columns;
                                    property <length> card-height: 168px;
                                    content-height: ceil(root.timer-rows.length / self.columns) * (self.card-height + self.gap) - self.gap;
                                    for t[i] in root.timer-rows: Card {
                                        x: mod(i, timer-board.columns) * (timer-board.card-width + timer-board.gap);
                                        y: floor(i / timer-board.columns) * (timer-board.card-height + timer-board.gap);
                                        width: timer-board.card-width;
                                        height: timer-board.card-height;
                                        border-color: t.on ? t.color.with-alpha(0.6) : Theme.border;
                                        VerticalLayout {
                                            padding: 14px;
                                            spacing: 4px;
                                            HorizontalLayout {
                                                spacing: 6px;
                                                Rectangle { width: 8px; height: 8px; y: (parent.height - self.height) / 2; border-radius: 4px; background: t.color; }
                                                SectionTitle { text: t.kind; horizontal-stretch: 1; }
                                                if t.on: Rectangle {
                                                    width: live-text.preferred-width + 12px;
                                                    height: 18px;
                                                    border-radius: 9px;
                                                    background: t.color.with-alpha(0.18);
                                                    live-text := Text { text: "LIVE"; color: t.color; font-size: 10px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                                }
                                            }
                                            Text { text: t.name; color: Theme.text; font-size: 15px; font-weight: 600; overflow: elide; }
                                            Text { text: t.detail; color: Theme.faint; font-size: 11px; overflow: elide; }
                                            Rectangle { vertical-stretch: 1; }
                                            HorizontalLayout {
                                                spacing: 8px;
                                                Text { text: t.countdown; color: t.on ? t.color : Theme.text; font-size: 24px; font-weight: 700; }
                                                Text { text: t.caption; color: Theme.muted; font-size: 11px; vertical-alignment: bottom; horizontal-stretch: 1; overflow: elide; }
                                            }
                                            Rectangle {
                                                height: 6px;
                                                border-radius: 3px;
                                                background: Theme.border;
                                                Rectangle {
                                                    x: 0;
                                                    width: parent.width * t.progress;
                                                    height: parent.height;
                                                    border-radius: 3px;
                                                    background: t.color;
                                                }
                                            }
                                            HorizontalLayout {
                                                Text { text: t.last; color: Theme.faint; font-size: 11px; horizontal-stretch: 1; overflow: elide; }
                                                Text { text: t.when; color: Theme.muted; font-size: 11px; horizontal-alignment: right; }
                                            }
                                        }
                                    }
                                }
                            }

                            if root.tab == 1: HorizontalLayout {
                                spacing: 12px;
                                VerticalLayout {
                                    spacing: 10px;
                                    horizontal-stretch: 1;
                                    HorizontalLayout {
                                        spacing: 8px;
                                        height: 36px;
                                        Dropdown {
                                            y: (parent.height - self.height) / 2;
                                            icon: Icons.map;
                                            model: root.map-names;
                                            current-index <=> root.map-index;
                                            selected(i) => { root.map-selected(i); }
                                            width: 180px;
                                        }
                                        Rectangle { horizontal-stretch: 1; }
                                        if root.position-text != "": Rectangle {
                                            y: (parent.height - self.height) / 2;
                                            height: 28px;
                                            width: position.preferred-width + 34px;
                                            border-radius: 14px;
                                            background: Theme.surface;
                                            border-width: 1px;
                                            border-color: Theme.border;
                                            Rectangle {
                                                x: 11px;
                                                y: (parent.height - self.height) / 2;
                                                width: 8px;
                                                height: 8px;
                                                border-radius: 4px;
                                                background: root.position-color;
                                            }
                                            position := Text {
                                                x: 26px;
                                                text: root.position-text;
                                                color: Theme.muted;
                                                font-size: 12px;
                                                vertical-alignment: center;
                                            }
                                        }
                                        Toggle {
                                            y: (parent.height - self.height) / 2;
                                            text: "Overlay";
                                            checked <=> root.map-overlay;
                                            toggled(on) => { root.map-overlay-changed(on); }
                                        }
                                        IconButton {
                                            y: (parent.height - self.height) / 2;
                                            boxed: true;
                                            active: root.follow;
                                            icon: Icons.locate-fixed;
                                            clicked => {
                                                root.follow = !root.follow;
                                                root.follow-changed(root.follow);
                                                if (root.follow) { root.center-on-player(); }
                                            }
                                        }
                                    }
                                    Rectangle {
                                        vertical-stretch: 1;
                                        border-radius: Theme.radius;
                                        border-width: 1px;
                                        border-color: Theme.border;
                                        clip: true;
                                        MapView {
                                            init => { root.map-width = self.width; root.map-height = self.height; }
                                            changed width => { root.map-width = self.width; }
                                            changed height => { root.map-height = self.height; }
                                            tiles: root.tiles;
                                            layer: root.layer;
                                            labels: root.labels;
                                            boss-labels: root.boss-labels;
                                            me-visible: root.me-visible;
                                            me-x: root.me-x;
                                            me-y: root.me-y;
                                            me-heading: root.me-heading;
                                            me-color: root.me-color;
                                            me-label: root.me-label;
                                            radar-radius: root.radar-radius;
                                            pan-by(dx, dy) => { root.pan-by(dx, dy); }
                                            zoom-by(d, x, y) => { root.zoom-by(d, x, y); }
                                        }
                                        VerticalLayout {
                                            x: parent.width - self.preferred-width - 10px;
                                            y: parent.height - self.preferred-height - 10px;
                                            spacing: 6px;
                                            IconButton { boxed: true; icon: Icons.plus; clicked => { root.zoom-by(240, root.map-width / 2, root.map-height / 2); } }
                                            IconButton { boxed: true; icon: Icons.minus; clicked => { root.zoom-by(-240, root.map-width / 2, root.map-height / 2); } }
                                        }
                                        // the shown field bosses out of view: a click finds the boss
                                        VerticalLayout {
                                            x: 10px;
                                            y: parent.height - self.preferred-height - 10px;
                                            width: 230px;
                                            spacing: 6px;
                                            for p in root.boss-pins: Rectangle {
                                                height: 44px;
                                                border-radius: 8px;
                                                background: pin-touch.has-hover ? Theme.surface-hover : Theme.surface-raised.with-alpha(0.94);
                                                border-width: 1px;
                                                border-color: Theme.control-border;
                                                pin-touch := TouchArea { clicked => { root.focus-pinned-boss(p.world-id); } }
                                                HorizontalLayout {
                                                    padding-left: 8px;
                                                    padding-right: 10px;
                                                    spacing: 8px;
                                                    Rectangle {
                                                        width: 30px;
                                                        height: 30px;
                                                        y: (parent.height - self.height) / 2;
                                                        border-radius: 15px;
                                                        border-width: 2px;
                                                        border-color: p.color;
                                                        background: #000000a0;
                                                        if !p.glyph: Rectangle {
                                                            x: 2px;
                                                            y: 2px;
                                                            width: 26px;
                                                            height: 26px;
                                                            border-radius: 13px;
                                                            clip: true;
                                                            Image { width: 26px; height: 26px; source: p.icon; image-fit: contain; }
                                                        }
                                                        if p.glyph: Icon {
                                                            x: 7px;
                                                            y: 7px;
                                                            width: 16px;
                                                            height: 16px;
                                                            commands: Icons.skull;
                                                            tint: p.color;
                                                            stroke-width: 1.6px;
                                                        }
                                                    }
                                                    VerticalLayout {
                                                        alignment: center;
                                                        horizontal-stretch: 1;
                                                        Text { text: p.name; color: Theme.text; font-weight: 600; overflow: elide; }
                                                        Text { text: p.detail; color: Theme.faint; font-size: 11px; overflow: elide; }
                                                    }
                                                    Text { text: p.status; color: p.color; font-weight: 600; vertical-alignment: center; }
                                                }
                                            }
                                        }
                                    }
                                }
                                Card {
                                    width: root.sidebar-width;
                                    // drag the left edge to make the list wider (long names) or narrower
                                    grip := TouchArea {
                                        x: 0px;
                                        width: 7px;
                                        mouse-cursor: ew-resize;
                                        property <length> press-x;
                                        pointer-event(e) => {
                                            if (e.kind == PointerEventKind.down) { self.press-x = self.mouse-x; }
                                            if (e.kind == PointerEventKind.up) { root.sidebar-width-changed(root.sidebar-width); }
                                        }
                                        moved => {
                                            if (self.pressed) {
                                                root.sidebar-width = clamp(root.sidebar-width - (self.mouse-x - self.press-x), 240px, max(240px, root.width - 68px - 32px - 320px));
                                            }
                                        }
                                    }
                                    if grip.has-hover || grip.pressed: Rectangle {
                                        x: 2px;
                                        y: (parent.height - self.height) / 2;
                                        width: 3px;
                                        height: 40px;
                                        border-radius: 1.5px;
                                        background: Theme.accent;
                                    }
                                    VerticalLayout {
                                        padding: 10px;
                                        spacing: 8px;
                                        VerticalLayout {
                                            CheckRow { text: "Live monsters"; checked: root.show-live-mobs; dot: #e05050; glyph: true; toggled(on) => { root.show-live-mobs = on; root.live-mobs-changed(on); } }
                                            HorizontalLayout {
                                                spacing: 2px;
                                                CheckRow { horizontal-stretch: 1; text: "Hidden Cubes"; checked: root.show-cubes; dot: #ffd84d; icon: root.cube-icon; toggled(on) => { root.show-cubes = on; root.cubes-changed(on); } }
                                                // the sound near a Hidden Cube: on or off, volume, test
                                                IconButton {
                                                    width: 30px;
                                                    height: 30px;
                                                    icon-size: 16px;
                                                    icon: Icons.settings;
                                                    active: root.sound-panel-open || root.cube-sound;
                                                    clicked => {
                                                        if (root.sound-panel-open) {
                                                            root.close-sound-panel();
                                                        } else {
                                                            root.sound-anchor = self.absolute-position;
                                                            root.sound-panel-open = true;
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                        Rectangle { height: 1px; background: Theme.border; }
                                        SegmentBar {
                                            HorizontalLayout {
                                                padding: 3px;
                                                spacing: 2px;
                                                Segment { horizontal-stretch: 1; icon: Icons.pickaxe; active: root.filter-tab == 0; clicked => { root.filter-tab = 0; } }
                                                Segment { horizontal-stretch: 1; icon: Icons.paw-print; active: root.filter-tab == 1; clicked => { root.filter-tab = 1; } }
                                                Segment { horizontal-stretch: 1; icon: Icons.skull; active: root.filter-tab == 2; clicked => { root.filter-tab = 2; } }
                                            }
                                        }
                                        if root.filter-tab == 0: SearchField {
                                            placeholder: "Search resources";
                                            text <=> root.resource-query;
                                            edited(t) => { root.resource-search(t); }
                                        }
                                        if root.filter-tab == 1: SearchField {
                                            placeholder: "Search monsters";
                                            text <=> root.monster-query;
                                            edited(t) => { root.monster-search(t); }
                                        }
                                        if root.filter-tab == 2: VerticalLayout {
                                            vertical-stretch: 1;
                                            spacing: 6px;
                                            HorizontalLayout {
                                                spacing: 6px;
                                                SearchField {
                                                    horizontal-stretch: 1;
                                                    placeholder: "Search field bosses";
                                                    text <=> root.boss-query;
                                                    edited(t) => { root.boss-search(t); }
                                                }
                                                // pin the ticked bosses that are out of view in a corner of the map
                                                IconButton {
                                                    y: (parent.height - self.height) / 2;
                                                    icon: Icons.pin;
                                                    active: root.boss-pins-on;
                                                    clicked => {
                                                        root.boss-pins-on = !root.boss-pins-on;
                                                        root.boss-pins-changed(root.boss-pins-on);
                                                    }
                                                }
                                            }
                                            if root.boss-summary != "": Muted { text: root.boss-summary; font-size: 11px; wrap: word-wrap; }
                                            ListView {
                                                vertical-stretch: 1;
                                                for b in root.boss-rows: Rectangle {
                                                    height: 40px;
                                                    border-radius: 6px;
                                                    background: boss-touch.has-hover ? Theme.surface-hover : transparent;
                                                    // a click finds the boss on the map (and shows it); the tick shows or hides it
                                                    boss-touch := TouchArea { clicked => { root.focus-boss(b.index); } }
                                                    HorizontalLayout {
                                                        padding-left: 8px;
                                                        padding-right: 8px;
                                                        spacing: 8px;
                                                        Rectangle {
                                                            width: 22px;
                                                            CheckMark { x: 0; y: (parent.height - self.height) / 2; checked: b.shown; }
                                                            TouchArea { clicked => { root.toggle-boss(b.index, !b.shown); } }
                                                        }
                                                        Rectangle { width: 8px; height: 8px; y: (parent.height - self.height) / 2; border-radius: 4px; background: b.color; }
                                                        VerticalLayout {
                                                            alignment: center;
                                                            horizontal-stretch: 1;
                                                            Text { text: b.name; color: Theme.text; overflow: elide; }
                                                            if b.detail != "": Text { text: b.detail; color: Theme.faint; font-size: 11px; overflow: elide; }
                                                        }
                                                        Text { text: b.status; color: b.color; font-weight: 600; vertical-alignment: center; }
                                                    }
                                                }
                                            }
                                        }
                                        if root.filter-tab != 2: HorizontalLayout {
                                            height: 22px;
                                            spacing: 10px;
                                            padding-left: 4px;
                                            Muted {
                                                text: root.filter-tab == 0 ? root.resource-summary : root.monster-summary;
                                                font-size: 11px;
                                                horizontal-stretch: 1;
                                                overflow: elide;
                                            }
                                            if root.filter-tab == 1: Text {
                                                text: "Select shown";
                                                color: select-all.has-hover ? Theme.accent-hover : Theme.accent;
                                                font-size: 11px;
                                                vertical-alignment: center;
                                                select-all := TouchArea { clicked => { root.select-shown-monsters(); } }
                                            }
                                            Text {
                                                text: "Clear";
                                                color: clear-all.has-hover ? Theme.accent-hover : Theme.accent;
                                                font-size: 11px;
                                                vertical-alignment: center;
                                                clear-all := TouchArea { clicked => { if (root.filter-tab == 0) { root.clear-resources(); } else { root.clear-monsters(); } } }
                                            }
                                        }
                                        if root.filter-tab == 0: ListView {
                                            vertical-stretch: 1;
                                            for r in root.resource-rows: Rectangle {
                                                height: 30px;
                                                if r.header: Rectangle {
                                                    border-radius: 6px;
                                                    HorizontalLayout {
                                                        padding-left: 2px;
                                                        Rectangle {
                                                            width: 22px;
                                                            border-radius: 6px;
                                                            background: header-touch.has-hover ? Theme.surface-hover : transparent;
                                                            Icon {
                                                                x: 3px;
                                                                y: (parent.height - self.height) / 2;
                                                                width: 16px;
                                                                height: 16px;
                                                                commands: r.expanded ? Icons.chevron-down : Icons.chevron-right;
                                                                tint: Theme.muted;
                                                            }
                                                            header-touch := TouchArea { clicked => { root.expand-kind(r.key); } }
                                                        }
                                                        CheckRow {
                                                            horizontal-stretch: 1;
                                                            text: r.label;
                                                            detail: r.detail;
                                                            checked: r.checked;
                                                            partial: r.partial;
                                                            dot: r.color;
                                                            icon: r.icon;
                                                            toggled(on) => { root.toggle-kind(r.key, on); }
                                                        }
                                                    }
                                                }
                                                if !r.header: CheckRow {
                                                    indent: 24px;
                                                    text: r.label;
                                                    detail: r.detail;
                                                    checked: r.checked;
                                                    dot: r.checked ? r.color : transparent;
                                                    icon: r.icon;
                                                    toggled(on) => { root.toggle-gather(r.key, on); }
                                                }
                                            }
                                        }
                                        // pets that can be farmed, each with the monsters that give it, then the other monsters
                                        if root.filter-tab == 1: ListView {
                                            vertical-stretch: 1;
                                            for r in root.monster-rows: Rectangle {
                                                height: 30px;
                                                if r.header: HorizontalLayout {
                                                    padding-left: 2px;
                                                    Rectangle {
                                                        width: 22px;
                                                        border-radius: 6px;
                                                        background: pet-touch.has-hover ? Theme.surface-hover : transparent;
                                                        Icon {
                                                            x: 3px;
                                                            y: (parent.height - self.height) / 2;
                                                            width: 16px;
                                                            height: 16px;
                                                            commands: r.expanded ? Icons.chevron-down : Icons.chevron-right;
                                                            tint: Theme.muted;
                                                        }
                                                        pet-touch := TouchArea { clicked => { root.expand-pet(r.key); } }
                                                    }
                                                    CheckRow {
                                                        horizontal-stretch: 1;
                                                        text: r.label;
                                                        detail: r.detail;
                                                        checked: r.checked;
                                                        partial: r.partial;
                                                        dot: r.checked || r.partial ? r.color : transparent;
                                                        icon: r.icon;
                                                        toggled(on) => { root.toggle-pet(r.key, on); }
                                                    }
                                                }
                                                if !r.header: CheckRow {
                                                    indent: r.child ? 24px : 0px;
                                                    text: r.label;
                                                    detail: r.detail;
                                                    checked: r.checked;
                                                    dot: r.checked ? r.color : transparent;
                                                    icon: r.icon;
                                                    glyph: r.glyph;
                                                    toggled(on) => { root.toggle-monster(r.key, on); }
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                        }

                        // ------------------------------------------------ rail, drawn over the pages so its tooltips stay visible
                        Rectangle {
                            x: 0;
                            width: 68px;
                            background: Theme.chrome;
                            Rectangle {
                                x: parent.width - 1px;
                                width: 1px;
                                background: Theme.chrome-line;
                            }
                            VerticalLayout {
                                padding-top: 16px;
                                padding-bottom: 14px;
                                spacing: 10px;
                                alignment: start;
                                HorizontalLayout { alignment: center; RailButton { icon: Icons.map; tooltip: "Map"; active: root.tab == 1; clicked => { root.tab = 1; } } }
                                HorizontalLayout { alignment: center; RailButton { icon: Icons.swords; tooltip: "DPS"; active: root.tab == 0 || root.tab == 2; clicked => { root.open-dps(); } } }
                                HorizontalLayout { alignment: center; RailButton { icon: Icons.paw-print; tooltip: "Pets"; active: root.tab == 3; clicked => { root.tab = 3; } } }
                                HorizontalLayout { alignment: center; RailButton { icon: Icons.clock; tooltip: "Timers"; active: root.tab == 5; clicked => { root.tab = 5; } } }
                            }
                            VerticalLayout {
                                y: parent.height - self.preferred-height;
                                padding-bottom: 14px;
                                spacing: 10px;
                                HorizontalLayout {
                                    alignment: center;
                                    RailButton {
                                        icon: root.overlays-locked ? Icons.lock : Icons.lock-open;
                                        tooltip: root.overlays-locked ? "Unlock overlays (Ctrl L)" : "Lock overlays (Ctrl L)";
                                        active: root.overlays-locked;
                                        clicked => {
                                            root.overlays-locked = !root.overlays-locked;
                                            root.lock-changed(root.overlays-locked);
                                        }
                                    }
                                }
                                HorizontalLayout { alignment: center; RailButton { icon: Icons.user-round; tooltip: "Profile"; active: root.tab == 4; clicked => { root.tab = 4; } } }
                                HorizontalLayout {
                                    alignment: center;
                                    status := Rectangle {
                                        width: 44px;
                                        height: 28px;
                                        Rectangle {
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                            width: 10px;
                                            height: 10px;
                                            border-radius: 5px;
                                            background: root.capture-color;
                                        }
                                        status-touch := TouchArea { }
                                        if status-touch.has-hover: Rectangle {
                                            x: parent.width + 10px;
                                            y: (parent.height - self.height) / 2;
                                            width: min(tip.preferred-width, 520px);
                                            height: tip.preferred-height;
                                            border-radius: 6px;
                                            background: Theme.surface-raised;
                                            border-width: 1px;
                                            border-color: Theme.control-border;
                                            tip := VerticalLayout {
                                                padding-left: 10px;
                                                padding-right: 10px;
                                                padding-top: 6px;
                                                padding-bottom: 6px;
                                                spacing: 4px;
                                                Text {
                                                    text: root.capture-state;
                                                    color: Theme.text;
                                                    font-size: 12px;
                                                    overflow: elide;
                                                }
                                                if root.ping-text != "": HorizontalLayout {
                                                    spacing: 8px;
                                                    Text { text: "Ping"; color: Theme.muted; font-size: 12px; vertical-alignment: center; }
                                                    PingBadge { alignment: start; text: root.ping-text; tint: root.ping-color; }
                                                }
                                            }
                                        }
                                    }
                                }
                                HorizontalLayout { alignment: center; RailButton { icon: Icons.settings; tooltip: "Settings"; active: root.settings-open; clicked => { root.settings-open = true; } } }
                            }
                        }
                    }
                }
            }
        }
    }

    // ------------------------------------------------ settings dialog (zodiak's: tabs left, title and close on top)
    if root.settings-open: Rectangle {
        background: #07080cc9;
        TouchArea { clicked => { root.settings-open = false; } }
        Rectangle {
            width: min(600px, parent.width - 48px);
            height: min(520px, parent.height - 56px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: #1a1b22;
            border-radius: 16px;
            border-width: 1px;
            border-color: #3a3948;
            drop-shadow-blur: 60px;
            drop-shadow-color: #00000088;
            clip: true;
            TouchArea { }
            HorizontalLayout {
                Rectangle {
                    width: 160px;
                    background: #15161c;
                    Rectangle { x: parent.width - 1px; width: 1px; background: Theme.border; }
                    VerticalLayout {
                        padding: 12px;
                        spacing: 5px;
                        alignment: start;
                        SettingsTab { icon: Icons.user-round; text: "General"; active: root.settings-tab == 0; clicked => { root.settings-tab = 0; } }
                        SettingsTab { icon: Icons.monitor; text: "Overlays"; active: root.settings-tab == 1; clicked => { root.settings-tab = 1; } }
                    }
                }
                VerticalLayout {
                    Rectangle {
                        height: 54px;
                        HorizontalLayout {
                            padding-left: 24px;
                            padding-right: 14px;
                            Text {
                                text: root.settings-tab == 0 ? "General" : "Overlays";
                                color: Theme.text;
                                font-size: 14px;
                                font-weight: 600;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                            IconButton { y: (parent.height - self.height) / 2; icon: Icons.x; clicked => { root.settings-open = false; } }
                        }
                        Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
                    }
                    Flickable {
                        vertical-stretch: 1;
                        content-height: panel.preferred-height;
                        panel := VerticalLayout {
                            padding-left: 24px;
                            padding-right: 24px;
                            padding-top: 20px;
                            padding-bottom: 20px;
                            spacing: 18px;
                            alignment: start;

                            if root.settings-tab == 0: VerticalLayout {
                                spacing: 18px;
                                VerticalLayout {
                                    spacing: 8px;
                                    FieldLabel { text: "Character name"; }
                                    Rectangle {
                                        height: 40px;
                                        border-radius: 8px;
                                        background: Theme.input;
                                        border-width: 1px;
                                        border-color: name-input.has-focus ? Theme.accent : Theme.border;
                                        clip: true;
                                        name-input := TextInput {
                                            x: 12px;
                                            width: parent.width - 24px;
                                            height: parent.height;
                                            vertical-alignment: center;
                                            text <=> root.own-name;
                                            color: Theme.text;
                                            single-line: true;
                                            edited => { root.own-name-edited(self.text); }
                                        }
                                        if root.own-name == "": Text {
                                            x: 12px;
                                            height: parent.height;
                                            vertical-alignment: center;
                                            text: "learned from the login";
                                            color: #737585;
                                        }
                                    }
                                }
                                SwitchRow { text: "Reset on zone change"; checked <=> root.reset-on-zone; toggled(on) => { root.reset-on-zone-changed(on); } }
                                Rectangle { height: 1px; background: Theme.border; }
                                HorizontalLayout {
                                    spacing: 10px;
                                    Text { text: "Record game traffic"; color: #d0cfdd; font-size: 13px; vertical-alignment: center; }
                                    Rectangle { horizontal-stretch: 1; }
                                    IconButton {
                                        boxed: true;
                                        active: root.recording;
                                        icon: root.recording ? Icons.square : Icons.circle-dot;
                                        clicked => { if (root.recording) { root.stop-recording(); } else { root.start-recording(); } }
                                    }
                                }
                                if root.recording: Text { text: root.recording-text; color: #888b9e; font-size: 11px; wrap: word-wrap; }
                            }

                            // the overlays, each in its sub tab; General holds what all of them share
                            if root.settings-tab == 1: VerticalLayout {
                                spacing: 6px;
                                SegmentBar {
                                    HorizontalLayout {
                                        padding: 3px;
                                        spacing: 2px;
                                        Segment { horizontal-stretch: 1; text: "General"; active: root.overlay-settings-tab == 0; clicked => { root.overlay-settings-tab = 0; } }
                                        Segment { horizontal-stretch: 1; text: "Meter"; icon: Icons.swords; active: root.overlay-settings-tab == 1; clicked => { root.overlay-settings-tab = 1; } }
                                        Segment { horizontal-stretch: 1; text: "Map"; icon: Icons.map; active: root.overlay-settings-tab == 2; clicked => { root.overlay-settings-tab = 2; } }
                                        Segment { horizontal-stretch: 1; text: "Pets"; icon: Icons.paw-print; active: root.overlay-settings-tab == 3; clicked => { root.overlay-settings-tab = 3; } }
                                    }
                                }
                                Rectangle { height: 10px; }

                                if root.overlay-settings-tab == 0: VerticalLayout {
                                    spacing: 6px;
                                    SwitchRow { text: "Lock, click through"; shortcut: "Ctrl L"; checked <=> root.overlays-locked; toggled(on) => { root.lock-changed(on); } }
                                    Rectangle { height: 10px; }
                                    VerticalLayout {
                                        spacing: 6px;
                                        HorizontalLayout {
                                            FieldLabel { text: "Opacity"; horizontal-stretch: 1; }
                                            FieldLabel { text: round(root.overlay-opacity * 100) + "%"; }
                                        }
                                        SliderBar { minimum: 0.2; maximum: 1.0; value <=> root.overlay-opacity; changed(v) => { root.opacity-changed(v); } }
                                    }
                                }

                                if root.overlay-settings-tab == 1: VerticalLayout {
                                    spacing: 6px;
                                    SwitchRow { text: "Meter overlays"; shortcut: "Ctrl O"; checked <=> root.meter-overlay; toggled(on) => { root.meter-overlay-changed(on); } }
                                    Rectangle { height: 10px; }
                                    Rectangle { height: 1px; background: Theme.border; }
                                    Rectangle { height: 10px; }
                                    for cfg in root.overlay-configs: VerticalLayout {
                                        spacing: 8px;
                                        padding-bottom: 14px;
                                        HorizontalLayout {
                                            spacing: 8px;
                                            height: 30px;
                                            Text { text: "Meter overlay " + cfg.id; color: #d0cfdd; font-size: 13px; vertical-alignment: center; }
                                            Rectangle { horizontal-stretch: 1; }
                                            IconButton {
                                                y: (parent.height - self.height) / 2;
                                                width: 28px;
                                                height: 28px;
                                                icon-size: 15px;
                                                icon: Icons.x;
                                                clicked => { root.overlay-remove(cfg.id); }
                                            }
                                            Toggle {
                                                y: (parent.height - self.height) / 2;
                                                checked: cfg.enabled;
                                                toggled(on) => { root.overlay-changed({ id: cfg.id, enabled: on, metric: cfg.metric, range: cfg.range, scope: cfg.scope }); }
                                            }
                                        }
                                        HorizontalLayout {
                                            spacing: 6px;
                                            Dropdown {
                                                horizontal-stretch: 1;
                                                model: ["Damage", "Healing"];
                                                current-index: cfg.metric;
                                                selected(i) => { root.overlay-changed({ id: cfg.id, enabled: cfg.enabled, metric: i, range: cfg.range, scope: cfg.scope }); }
                                            }
                                            Dropdown {
                                                horizontal-stretch: 1;
                                                model: ["Fight", "Total"];
                                                current-index: cfg.range;
                                                selected(i) => { root.overlay-changed({ id: cfg.id, enabled: cfg.enabled, metric: cfg.metric, range: i, scope: cfg.scope }); }
                                            }
                                            Dropdown {
                                                horizontal-stretch: 1;
                                                model: ["All", "Group", "Me"];
                                                current-index: cfg.scope;
                                                selected(i) => { root.overlay-changed({ id: cfg.id, enabled: cfg.enabled, metric: cfg.metric, range: cfg.range, scope: i }); }
                                            }
                                        }
                                    }
                                    HorizontalLayout {
                                        alignment: start;
                                        TextButton { icon: Icons.plus; text: "Add meter overlay"; clicked => { root.overlay-add(); } }
                                    }
                                }

                                if root.overlay-settings-tab == 2: VerticalLayout {
                                    spacing: 6px;
                                    SwitchRow { text: "Map overlay"; shortcut: "Ctrl M"; checked <=> root.map-overlay; toggled(on) => { root.map-overlay-changed(on); } }
                                    Rectangle { height: 10px; }
                                    VerticalLayout {
                                        spacing: 6px;
                                        HorizontalLayout {
                                            FieldLabel { text: "Map overlay radius"; horizontal-stretch: 1; }
                                            FieldLabel { text: round(root.overlay-radius) + " m"; }
                                        }
                                        SliderBar { minimum: 25; maximum: 1000; value <=> root.overlay-radius; changed(v) => { root.overlay-radius-changed(v); } }
                                    }
                                }

                                if root.overlay-settings-tab == 3: VerticalLayout {
                                    spacing: 6px;
                                    SwitchRow { text: "Pet overlay"; shortcut: "Ctrl P"; checked <=> root.pet-overlay; toggled(on) => { root.pet-overlay-changed(on); } }
                                    SwitchRow { text: "Add the pet of the monster you fight"; checked <=> root.pet-overlay-target; toggled(on) => { root.pet-overlay-target-changed(on); } }
                                    SwitchRow { text: "Sync pinned pets with the monsters ticked on the map"; checked <=> root.pet-auto-pin; toggled(on) => { root.pet-auto-pin-changed(on); } }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // the cube sound settings, drawn over the window; a click anywhere else closes them
    if root.sound-panel-open: TouchArea {
        clicked => { root.close-sound-panel(); }
    }
    if root.sound-panel-open: Rectangle {
        x: min(root.sound-anchor.x + 30px - self.width, root.width - self.width - 8px);
        y: root.sound-anchor.y + 36px;
        width: 268px;
        height: 148px;
        background: Theme.surface;
        border-radius: 10px;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 18px;
        drop-shadow-color: #00000090;
        TouchArea { }
        VerticalLayout {
            padding: 12px;
            spacing: 12px;
            SwitchRow { text: "Sound near a Hidden Cube"; height: 28px; checked <=> root.cube-sound; toggled(on) => { root.cube-sound-changed(on); } }
            HorizontalLayout {
                spacing: 8px;
                Icon {
                    y: (parent.height - self.height) / 2;
                    width: 16px;
                    height: 16px;
                    commands: Icons.volume-2;
                    tint: Theme.muted;
                }
                SliderBar {
                    horizontal-stretch: 1;
                    minimum: 0;
                    maximum: 100;
                    value <=> root.cube-volume;
                    changed(v) => { root.cube-volume-changed(v); }
                }
                Muted { text: round(root.cube-volume) + "%"; width: 36px; horizontal-alignment: right; }
            }
            TextButton {
                primary: root.sound-testing;
                icon: root.sound-testing ? Icons.square : Icons.play;
                text: root.sound-testing ? "Stop" : "Test";
                clicked => {
                    root.sound-testing = !root.sound-testing;
                    root.test-cube-sound(root.sound-testing);
                }
            }
        }
    }

    if !root.is-maximized: ResizeGrips { resize(edge) => { root.window-resize(edge); } }
}
